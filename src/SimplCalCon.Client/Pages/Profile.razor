@page "/profile"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Profile</PageTitle>

<h1>Profile</h1>

@if (me is null)
{
    <p>Loading…</p>
}
else
{
    <div class="profile-head">
        <div class="profile-name">@me.DisplayName</div>
        <div class="profile-email">@me.Email</div>
        <div class="profile-role">@RoleLabel</div>
    </div>

    <h2>Photo</h2>
    <AvatarEditor Path="api/users/me/photo" Initials="@me.Initials" />
}

@code {
    private MeDto? me;

    private string RoleLabel => me?.Role switch
    {
        "platform_admin" => "Platform administrator",
        "admin" => "Tenant administrator",
        _ => "Member",
    };

    protected override async Task OnInitializedAsync() => me = await Api.GetMeAsync();
}
