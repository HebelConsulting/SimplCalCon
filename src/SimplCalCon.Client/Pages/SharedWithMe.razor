@page "/shared"
@attribute [Authorize]
@implements IDisposable
@inject ApiClient Api
@inject NavigationManager Nav
@inject LiveUpdates Live

<PageTitle>Shared</PageTitle>

<SectionContent SectionName="RibbonSection">
    <a class="ribbon-btn" href="">← Overview</a>
</SectionContent>

<h1>Shared with me</h1>

@if (items is null)
{
    <p>Loading…</p>
}
else if (items.Count == 0)
{
    <p>Nothing has been shared with you yet.</p>
}
else
{
    <ul class="shared-list">
        @foreach (var item in items)
        {
            <li>
                <button class="shared-open" @onclick="() => Open(item)">@item.Name</button>
                <span class="shared-meta">
                    @(item.Kind == "calendars" ? "Calendar" : "Address book") · from @item.OwnerName · @string.Join(", ", item.Rights)
                </span>
            </li>
        }
    </ul>
}

<h1>Shared by me</h1>

@if (byMe is null)
{
    <p>Loading…</p>
}
else if (byMe.Count == 0)
{
    <p>You haven't shared any calendars or address books.</p>
}
else
{
    <ul class="shared-list">
        @foreach (var item in byMe)
        {
            <li>
                <button class="shared-open" @onclick="() => Open(item.Id, item.Kind)">@item.Name</button>
                <span class="shared-meta">@(item.Kind == "calendars" ? "Calendar" : "Address book")</span>
                <a class="ribbon-btn" href="share/@item.Kind/@item.Id">Manage</a>
                <ul class="shared-grants">
                    @foreach (var share in item.Shares)
                    {
                        <li>@share.DisplayName@(share.Kind == "group" ? " (group)" : "") · @string.Join(", ", share.Rights)</li>
                    }
                </ul>
            </li>
        }
    </ul>
}

@code {
    private IReadOnlyList<SharedCollectionDto>? items;
    private IReadOnlyList<SharedByMeDto>? byMe;

    protected override async Task OnInitializedAsync()
    {
        Live.SharesChanged += OnSharesChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        items = await Api.GetSharedWithMeAsync();
        byMe = await Api.GetSharedByMeAsync();
    }

    // A grant/revoke or group-membership change affecting me (ADR 0064) → reload both sections live.
    private void OnSharesChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private void Open(SharedCollectionDto item) => Open(item.Id, item.Kind);

    private void Open(Guid id, string kind) =>
        Nav.NavigateTo(kind == "calendars" ? $"calendars/{id}" : $"address-books/{id}");

    public void Dispose() => Live.SharesChanged -= OnSharesChanged;
}
