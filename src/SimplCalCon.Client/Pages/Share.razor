@page "/share/{Kind}/{CollectionId:guid}"
@attribute [Authorize]

<PageTitle>Share</PageTitle>

<SectionContent SectionName="RibbonSection">
    <a class="ribbon-btn" href="@(Kind == "calendars" ? "calendars" : "address-books")">← Back</a>
</SectionContent>

<h1>Sharing</h1>
<ShareEditor Kind="@Kind" CollectionId="CollectionId" />

@code {
    [Parameter] public string Kind { get; set; } = "calendars";
    [Parameter] public Guid CollectionId { get; set; }
}
