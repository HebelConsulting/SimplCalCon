    private void CancelScope()
    {
        scopeAction = string.Empty;
        scopeEvent = null;
    }

    private async Task ChooseScope(string scope)
    {
        var ev = scopeEvent;
        var action = scopeAction;
        CancelScope();
        if (ev is null)
        {
            return;
        }

        if (action == "edit")
        {
            await OpenEditForScopeAsync(ev, scope);
        }
        else if (selectedCalId is { } id)
        {
            if (scope == "all")
            {
                await Api.DeleteEventAsync(id, ev.Id);
            }
            else if (ev.RecurrenceId is { } recId)
            {
                await Api.DeleteOccurrenceAsync(id, ev.Id, recId, scope);
            }

            CloseDetail();
            await ReloadAllAsync();
        }
    }

    private async Task OpenEditForScopeAsync(EventDto clicked, string scope)
    {
        if (selectedCalId is not { } id)
        {
            return;
        }

        editingId = clicked.Id;
        editorCalId = id;
        editScope = scope == "all" ? "series" : scope; // "series" | "this" | "following"
        editRecurrenceId = clicked.RecurrenceId;
        ResetRecurrence();

        // "series" edits the master; "this"/"following" start from the clicked occurrence's values.
        var source = editScope == "series" ? await Api.GetEventAsync(id, clicked.Id) ?? clicked : clicked;
        summary = source.Summary ?? string.Empty;
        location = source.Location ?? string.Empty;
        isAllDay = source.IsAllDay;
        start = (source.StartUtc ?? DateTime.UtcNow).ToLocalTime();
        end = source.EndUtc?.ToLocalTime();
        attendees = string.Join(", ", (source.Attendees ?? []).Where(a => !a.IsOrganizer).Select(a => a.Address.Replace("mailto:", "")));
        monthlyDay = start.Day;
        monthlyWeekday = WeekdayCode(start);

        // Load the recurrence controls for series/following (a single occurrence has none).
        if (editScope != "this")
        {
            var master = editScope == "series" ? source : await Api.GetEventAsync(id, clicked.Id) ?? clicked;
            LoadRecurrenceFrom(master);
        }

        selected = null;
        editorError = null;
        showEditor = true;
    }

    private void LoadRecurrenceFrom(EventDto ev)
    {
        if (ev is { RecurrenceSupported: true, Recurrence: { } r })
        {
            repeatFreq = r.Frequency;
            repeatInterval = Math.Max(1, r.Interval);
            if (r.Frequency == "WEEKLY")
            {
                foreach (var d in r.ByDay)
                {
                    repeatDays.Add(d);
                }
            }
            else if (r.Frequency == "MONTHLY")
            {
                if (r.ByMonthDay is { } md)
                {
                    monthlyMode = "day";
                    monthlyDay = md;
                }
                else if (r.ByDay.Count == 1)
                {
                    monthlyMode = "weekday";
                    (monthlyOrdinal, monthlyWeekday) = ParseOrdinal(r.ByDay[0]);
                }
            }

            (repeatEnd, repeatUntil, repeatCount) = r switch
            {
                { Count: { } n } => ("count", (DateTime?)null, (int?)n),
                { UntilUtc: { } u } => ("until", u.ToLocalTime(), null),
                _ => ("never", null, null),
            };
        }
        else if (!string.IsNullOrWhiteSpace(ev.RecurrenceRule))
        {
            customRuleMode = true;
            customRule = ev.RecurrenceRule;
        }
    }

    private void CloseEditor() => showEditor = false;

    private void ResetRecurrence()
    {
        repeatFreq = string.Empty;
        repeatInterval = 1;
        repeatDays.Clear();
        repeatEnd = "never";
        repeatUntil = null;
        repeatCount = null;
        customRuleMode = false;
        customRule = null;
        monthlyMode = "day";
        monthlyOrdinal = 1;
    }

    private void ToggleDay(string code)
    {
        if (!repeatDays.Remove(code))
        {
            repeatDays.Add(code);
        }
    }

    private object? BuildRecurrenceBody()
    {
        if (repeatFreq.Length == 0)
        {
            return null;
        }

        var byDay = new List<string>();
        int? byMonthDay = null;
        if (repeatFreq == "WEEKLY")
        {
            byDay = repeatDays.ToList();
        }
        else if (repeatFreq == "MONTHLY")
        {
            if (monthlyMode == "day")
            {
                byMonthDay = monthlyDay;
            }
            else
            {
                byDay = [$"{monthlyOrdinal}{monthlyWeekday}"];
            }
        }

        return new
        {
            frequency = repeatFreq,
            interval = Math.Max(1, repeatInterval),
            byDay,
            byMonthDay,
            count = repeatEnd == "count" ? repeatCount : null,
            untilUtc = repeatEnd == "until" && repeatUntil is { } u
                ? DateTime.SpecifyKind(u.ToUniversalTime(), DateTimeKind.Utc)
                : (DateTime?)null,
        };
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(summary) || editorCalId is not { } id)
        {
            return;
        }

        editorError = null;
        var startUtc = DateTime.SpecifyKind(start.ToUniversalTime(), DateTimeKind.Utc);
        var endUtc = end is { } e ? DateTime.SpecifyKind(e.ToUniversalTime(), DateTimeKind.Utc) : (DateTime?)null;
        var invitees = attendees.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        var body = new Dictionary<string, object?>
        {
            ["summary"] = summary,
            ["startUtc"] = startUtc,
            ["endUtc"] = endUtc,
            ["isAllDay"] = isAllDay,
            ["location"] = string.IsNullOrWhiteSpace(location) ? null : location,
            ["attendees"] = invitees.Select(a => new { address = a }).ToList(),
        };

        // A single occurrence carries no repeat rule; series/following do.
        if (editScope != "this")
        {
            if (customRuleMode)
            {
                body["recurrenceRule"] = customRule; // preserve the imported rule verbatim
            }
            else if (BuildRecurrenceBody() is { } recurrence)
            {
                body["recurrence"] = recurrence;
            }
        }

        try
        {
            if (editScope is "this" or "following" && editingId is { } series && editRecurrenceId is { } recId)
            {
                await Api.UpdateOccurrenceAsync(id, series, recId, editScope, body);
            }
            else if (editingId is { } existing)
            {
                await Api.UpdateEventAsync(id, existing, body);
            }
            else
            {
                await Api.CreateEventAsync(id, body);
            }
        }
        catch (HttpRequestException ex)
        {
            editorError = $"Save failed: {ex.Message}";
            return;
        }

        showEditor = false;
        await ReloadAllAsync();
    }

    private static string WeekdayCode(DateTime d) => d.DayOfWeek switch
    {
        DayOfWeek.Monday => "MO",
        DayOfWeek.Tuesday => "TU",
        DayOfWeek.Wednesday => "WE",
        DayOfWeek.Thursday => "TH",
        DayOfWeek.Friday => "FR",
        DayOfWeek.Saturday => "SA",
        _ => "SU",
    };

    private static (int Ordinal, string Weekday) ParseOrdinal(string token) =>
        token.Length >= 3 && int.TryParse(token[..^2], out var ordinal)
            ? (ordinal, token[^2..])
            : (1, "MO");

    private static string RecurrenceText(EventDto e)
    {
        if (e is { RecurrenceSupported: true, Recurrence: { } r })
        {
            var unit = r.Frequency switch
            {
                "DAILY" => "day", "WEEKLY" => "week", "MONTHLY" => "month", "YEARLY" => "year", _ => "time",
            };
            var text = r.Interval == 1 ? $"Every {unit}" : $"Every {r.Interval} {unit}s";
            if (r.Frequency == "WEEKLY" && r.ByDay.Count > 0)
            {
                text += $" on {string.Join(", ", r.ByDay)}";
            }

            if (r.Count is { } n)
            {
                text += $", {n} times";
            }
            else if (r.UntilUtc is { } u)
            {
                text += $", until {u.ToLocalTime():d MMM yyyy}";
            }

            return text;
        }

        return e.RecurrenceRule is { } rule ? $"Custom rule ({rule})" : "Repeats";
    }

    // --- Import / export ---

    private void OnImportFile(InputFileChangeEventArgs e) => pendingImport = e.File;

    private async Task ImportAsync()
    {
        if (pendingImport is null || EffectiveId is not { } id)
        {
            return;
        }

        importing = true;
        try
        {
            using var buffer = new MemoryStream();
            await pendingImport.OpenReadStream(64 * 1024 * 1024).CopyToAsync(buffer);
            var result = await Api.ImportCollectionAsync("calendars", id, buffer.ToArray(), pendingImport.Name, conflict, importSeparate, mergeByName);
            importMessage = result is { CreatedCollections: > 0 }
                ? $"Created {result.CreatedCollections} calendar(s); imported {result.Imported}, skipped {result.Skipped}, failed {result.Failed}."
                : $"Imported {result?.Imported}, skipped {result?.Skipped}, failed {result?.Failed}.";
            importDone = true; // lock the inputs; the user can now only Close
            if (result is { CreatedCollections: > 0 })
            {
                calendars = await Api.GetCalendarsAsync(); // new calendars appear in the pane
                foreach (var c in calendars) // show the freshly created ones
                {
                    checkedIds.Add(c.Id);
                }

                await SaveStateAsync();
                await SubscribeCheckedAsync();
            }

            await ReloadAllAsync();
        }
        finally
        {
            importing = false;
        }
    }

    private async Task ExportAsync()
    {
        if (EffectiveId is { } id)
        {
            var bytes = await Api.ExportCollectionAsync("calendars", id);
            await JS.InvokeVoidAsync("simplDownload", "calendar.ics", "text/calendar", Convert.ToBase64String(bytes));
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.CollectionChanged -= OnCollectionChanged;
        try
        {
            if (columnResizer is not null)
            {
                await columnResizer.InvokeVoidAsync("dispose");
                await columnResizer.DisposeAsync();
            }

            if (columnModule is not null)
            {
                await columnModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone — nothing to clean up.
        }
    }
}
