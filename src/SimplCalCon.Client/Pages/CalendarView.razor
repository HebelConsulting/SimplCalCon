    // --- Grid geometry ---
    private static DateTime WeekStart(DateTime d) => d.Date.AddDays(-((int)d.DayOfWeek + 6) % 7); // Monday-based

    private IEnumerable<DateTime> VisibleDays()
    {
        if (gridMode == Grid.Week)
        {
            var weekStart = WeekStart(cursor);
            return Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i));
        }

        var first = new DateTime(cursor.Year, cursor.Month, 1);
        var gridStart = WeekStart(first);
        return Enumerable.Range(0, 42).Select(i => gridStart.AddDays(i)); // 6 weeks
    }

    private IEnumerable<CalEntry> EventsOn(DateTime day) =>
        (occEntries ?? []).Where(e => LocalStart(e.Event)?.Date == day.Date).OrderBy(e => e.Event.StartUtc);

    private string PeriodLabel => gridMode == Grid.Week
        ? $"{WeekStart(cursor):d MMM} – {WeekStart(cursor).AddDays(6):d MMM yyyy}"
        : cursor.ToString("MMMM yyyy");

    private async Task Prev()
    {
        cursor = gridMode == Grid.Week ? cursor.AddDays(-7) : cursor.AddMonths(-1);
        await LoadOccurrencesAsync();
