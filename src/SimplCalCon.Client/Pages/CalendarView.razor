@page "/calendars/{CalendarId:guid?}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject LiveUpdates Live

<PageTitle>Calendar</PageTitle>

@if (calendars is { Count: > 0 })
{
    <SectionContent SectionName="RibbonSection">
        <select value="@EffectiveId" @onchange="OnSwitch">
            @foreach (var c in calendars)
            {
                <option value="@c.Id">@c.Name@(c.Shared ? " (shared)" : "")</option>
            }
        </select>
        <button class="ribbon-btn @(viewMode == View.List ? "active" : "")" @onclick="() => viewMode = View.List">List</button>
        <button class="ribbon-btn @(viewMode == View.Calendar ? "active" : "")" @onclick="() => SetViewAsync(View.Calendar)">Calendar</button>
        <button @onclick="OpenNew">New event</button>
        <button @onclick="OpenImport">Import</button>
        <button @onclick="ExportAsync">Export .ics</button>
        @if (EffectiveId is { } id)
        {
            <button @onclick="OpenRename">Rename</button>
            <button @onclick="() => showDelete = true">Delete</button>
            <button @onclick="() => showShare = true">Share</button>
            <a class="ribbon-btn" href="trash/calendars/@id">Trash</a>
        }
        <a class="ribbon-btn" href="invitations">Invitations</a>
    </SectionContent>
}

@if (calendars is null || (calendars.Count > 0 && events is null))
{
    <p>Loading…</p>
}
else if (calendars.Count == 0)
{
    <p>No calendars yet — create one on the <a href="">Overview</a> tab.</p>
}
else
{
    <div class="cal-list @(viewMode == View.List ? "" : "hidden")">
        <table @ref="eventTable" class="event-table">
            <thead>
                <tr>
                    <th @onclick='() => Sort("start")'>Start <span class="sort">@Indicator("start")</span></th>
                    <th @onclick='() => Sort("title")'>Title <span class="sort">@Indicator("title")</span></th>
                    <th @onclick='() => Sort("location")'>Location <span class="sort">@Indicator("location")</span></th>
                    <th class="repeats-col" @onclick='() => Sort("repeats")'>Repeats <span class="sort">@Indicator("repeats")</span></th>
                </tr>
                <tr class="filter-row">
                    <th><FilterInput @bind-Value="fStart" /></th>
                    <th><FilterInput @bind-Value="fTitle" /></th>
                    <th><FilterInput @bind-Value="fLocation" /></th>
                    <th class="repeats-col">
                        <label title="Show only recurring events"><input type="checkbox" @bind="fRepeatsOnly" /> only</label>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in FilteredSorted())
                {
                    <tr @key="e.Id" class="@(selected?.Id == e.Id ? "sel" : "")" @onclick="() => Select(e)">
                        <td>@FormatStart(e)</td>
                        <td>@e.Summary</td>
                        <td>@e.Location</td>
                        <td class="repeats-col">@(e.IsRecurring ? "↻" : "")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (events!.Count == 0)
        {
            <p>No events.</p>
        }
    </div>

    @if (viewMode == View.Calendar)
    {
        <div class="cal-grid-wrap">
            <div class="grid-controls">
                <button @onclick="Prev" title="Previous">‹</button>
                <button @onclick="Today">Today</button>
                <button @onclick="Next" title="Next">›</button>
                <span class="period-label">@PeriodLabel</span>
                <span class="grid-spacer"></span>
                <button class="@(gridMode == Grid.Month ? "active" : "")" @onclick="() => SetGridAsync(Grid.Month)">Month</button>
                <button class="@(gridMode == Grid.Week ? "active" : "")" @onclick="() => SetGridAsync(Grid.Week)">Week</button>
            </div>

            <div class="grid-weekdays">
                @foreach (var name in WeekdayNames)
                {
                    <div class="weekday">@name</div>
                }
            </div>

            <div class="@(gridMode == Grid.Month ? "month-grid" : "week-grid")">
                @foreach (var day in VisibleDays())
                {
                    <div class="day-cell @(day.Month != cursor.Month && gridMode == Grid.Month ? "other-month" : "") @(day == DateTime.Today ? "today" : "")">
                        <div class="day-number">@day.Day</div>
                        @foreach (var e in EventsOn(day))
                        {
                            <button class="event-chip" title="@e.Summary" @onclick="() => Select(e)">
                                <span class="chip-time">@(e.IsAllDay ? "—" : LocalStart(e)?.ToString("HH:mm"))</span> @e.Summary
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

<Modal Visible="showEditor" Title="@(editingId is null ? "New event" : "Edit event")" OnClose="CloseEditor">
    <div class="form-row"><label>Summary</label><input @bind="summary" /></div>
    <label class="form-check"><input type="checkbox" @bind="isAllDay" /> <span>All day</span></label>
    <div class="form-row"><label>Start</label><input type="datetime-local" @bind="start" /></div>
    <div class="form-row"><label>End</label><input type="datetime-local" @bind="end" /></div>
    <div class="form-row"><label>Location</label><input @bind="location" /></div>
    <div class="form-row"><label>Attendees</label><input placeholder="comma-separated emails" @bind="attendees" /></div>

    @if (customRuleMode)
    {
        <div class="form-row">
            <label>Repeats</label>
            <span class="custom-rule" title="Edit this rule in a native calendar client">Custom rule (@customRule)</span>
        </div>
    }
    else
    {
        <div class="form-row">
            <label>Repeats</label>
            <select @bind="repeatFreq">
                <option value="">Does not repeat</option>
                <option value="DAILY">Daily</option>
                <option value="WEEKLY">Weekly</option>
                <option value="MONTHLY">Monthly</option>
                <option value="YEARLY">Yearly</option>
            </select>
        </div>
        @if (repeatFreq.Length > 0)
        {
            <div class="form-row">
                <label>Every</label>
                <input type="number" min="1" class="interval" @bind="repeatInterval" />
                <span>@FreqUnit</span>
            </div>
            @if (repeatFreq == "WEEKLY")
            {
                <div class="form-row">
                    <label>On</label>
                    <div class="weekday-toggles">
                        @foreach (var (code, name) in Weekdays)
                        {
                            <button type="button" class="wd @(repeatDays.Contains(code) ? "on" : "")"
                                    @onclick="() => ToggleDay(code)">@name</button>
                        }
                    </div>
                </div>
            }
            <div class="form-row">
                <label>Ends</label>
                <select @bind="repeatEnd">
                    <option value="never">Never</option>
                    <option value="until">On date</option>
                    <option value="count">After N times</option>
                </select>
                @if (repeatEnd == "until")
                {
                    <input type="date" @bind="repeatUntil" />
                }
                else if (repeatEnd == "count")
                {
                    <input type="number" min="1" class="interval" @bind="repeatCount" /> <span>times</span>
                }
            </div>
        }
    }

    @if (editorError is not null)
    {
        <p class="import-message">@editorError</p>
    }
    <div class="form-actions">
        <button @onclick="SaveAsync" disabled="@string.IsNullOrWhiteSpace(summary)">Save</button>
        <button @onclick="CloseEditor">Cancel</button>
    </div>
</Modal>

<Modal Visible="showImport" Title="Import calendar (.ics or .zip)" CloseDisabled="@importing" OnClose="() => showImport = false">
    <div class="form-row"><InputFile OnChange="OnImportFile" accept=".ics,.zip" disabled="@InputsLocked" /></div>
    @if (IsZipSelected)
    {
        <label class="form-check" title="Recreate the original calendars from the archive (e.g. a Google export)">
            <input type="checkbox" @bind="importSeparate" disabled="@InputsLocked" />
            <span>Create a separate calendar for each file in the archive</span>
        </label>
        @if (importSeparate)
        {
            <label class="form-check" title="Files that resolve to the same calendar name are merged into one calendar">
                <input type="checkbox" @bind="mergeByName" disabled="@InputsLocked" />
                <span>Assign entries by their X-WR-CALNAME — don't create multiple calendars with the same name</span>
            </label>
        }
    }
    <div class="form-row">
        <label>On conflict</label>
        <select @bind="conflict" disabled="@InputsLocked">
            <option value="skip">Skip duplicates</option>
            <option value="replace">Replace duplicates</option>
        </select>
    </div>
    <div class="form-actions">
        <button @onclick="ImportAsync" disabled="@(pendingImport is null || InputsLocked)">Import</button>
        <button @onclick="() => showImport = false" disabled="@importing">Close</button>
    </div>
    @if (importing)
    {
        <p class="import-message">Importing…</p>
    }
    else if (importMessage is not null)
    {
        <p class="import-message">@importMessage</p>
    }
</Modal>

<Modal Visible="selected is not null" Title="@(selected?.Summary ?? "Event")" OnClose="CloseDetail">
    @if (selected is { } ev)
    {
        <dl class="detail">
            <dt>When</dt>
            <dd>@FormatRange(ev)</dd>
            @if (ev.IsRecurring)
            {
                <dt>Repeats</dt>
                <dd>@RecurrenceText(ev)</dd>
            }
            @if (!string.IsNullOrWhiteSpace(ev.Location))
            {
                <dt>Location</dt>
                <dd>@ev.Location</dd>
            }
            @if (ev.Attendees is { Count: > 0 } people)
            {
                <dt>Attendees</dt>
                <dd>@string.Join(", ", people.Where(p => !p.IsOrganizer).Select(p => $"{p.CommonName ?? p.Address} ({p.ParticipationStatus})"))</dd>
            }
        </dl>
        <div class="form-actions">
            <button @onclick="() => OpenEditAsync(ev)">Edit</button>
            <a class="ribbon-btn" href="history/calendars/@EffectiveId/@ev.Id">History</a>
            @if (CanSplit(ev))
            {
                @if (splittingId == ev.Id)
                {
                    <input type="datetime-local" @bind="splitAt" />
                    <button @onclick="() => ConfirmSplitAsync(ev)">Split here</button>
                    <button @onclick="CancelSplit">Cancel</button>
                }
                else
                {
                    <button @onclick="() => BeginSplit(ev)">Split</button>
                }
            }
        </div>
        @if (calendars is { Count: > 1 })
        {
            <div class="form-row">
                <label>Move to</label>
                <select @bind="moveTarget">
                    <option value="">— choose calendar —</option>
                    @foreach (var c in calendars.Where(c => c.Id != EffectiveId))
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <button @onclick="() => MoveAsync(ev)" disabled="@string.IsNullOrEmpty(moveTarget)">Move</button>
            </div>
            @if (moveError is not null)
            {
                <p class="import-message">@moveError</p>
            }
        }
    }
</Modal>

<Modal Visible="showShare" Title="Share calendar" OnClose="() => showShare = false">
    @if (EffectiveId is { } sid)
    {
        <ShareEditor Kind="calendars" CollectionId="sid" />
    }
</Modal>

<Modal Visible="showRename" Title="Rename calendar" OnClose="() => showRename = false">
    <div class="form-row"><input @bind="renameName" placeholder="Calendar name" /></div>
    <div class="form-actions">
        <button @onclick="RenameAsync" disabled="@string.IsNullOrWhiteSpace(renameName)">Save</button>
        <button @onclick="() => showRename = false">Cancel</button>
    </div>
    @if (renameError is not null)
    {
        <p class="import-message">@renameError</p>
    }
</Modal>

<Modal Visible="showDelete" Title="Delete calendar" OnClose="() => showDelete = false">
    <p>Delete calendar “<strong>@SelectedCalendarName</strong>”? Its events will no longer appear. This can be undone by an administrator.</p>
    <div class="form-actions">
        <button class="danger" @onclick="DeleteAsync">Delete</button>
        <button @onclick="() => showDelete = false">Cancel</button>
    </div>
</Modal>

@code {
    private enum View { List, Calendar }
    private enum Grid { Month, Week }

    [Parameter]
    public Guid? CalendarId { get; set; }

    private IReadOnlyList<CalendarDto>? calendars;
    private IReadOnlyList<EventDto>? events;

    private View viewMode = View.List;
    private Grid gridMode = Grid.Month;
    private DateTime cursor = DateTime.Today;

    private string sortColumn = "start";
    private bool sortAscending = true;
    private string fStart = string.Empty, fTitle = string.Empty, fLocation = string.Empty;
    private bool fRepeatsOnly;

    private IReadOnlyList<EventDto>? occurrences;

    private EventDto? selected;
    private bool showEditor;
    private bool showImport;

    // --- Event editor (create + edit), including recurrence (ADR 0050) ---
    private Guid? editingId;                  // null = create
    private string summary = string.Empty;
    private string attendees = string.Empty;
    private string location = string.Empty;
    private DateTime start = DateTime.Now;
    private DateTime? end;
    private bool isAllDay;
    private string? editorError;

    private string repeatFreq = string.Empty; // "" | DAILY | WEEKLY | MONTHLY | YEARLY
    private int repeatInterval = 1;
    private readonly HashSet<string> repeatDays = [];
    private string repeatEnd = "never";       // never | until | count
    private DateTime? repeatUntil;
    private int? repeatCount;
    private bool customRuleMode;              // an imported rule the editor can't model — preserved verbatim
    private string? customRule;

    private static readonly (string Code, string Name)[] Weekdays =
        [("MO", "Mon"), ("TU", "Tue"), ("WE", "Wed"), ("TH", "Thu"), ("FR", "Fri"), ("SA", "Sat"), ("SU", "Sun")];

    private string FreqUnit => repeatFreq switch
    {
        "DAILY" => repeatInterval == 1 ? "day" : "days",
        "WEEKLY" => repeatInterval == 1 ? "week" : "weeks",
        "MONTHLY" => repeatInterval == 1 ? "month" : "months",
        "YEARLY" => repeatInterval == 1 ? "year" : "years",
        _ => "",
    };

    private Guid? splittingId;
    private DateTime splitAt;
    private IBrowserFile? pendingImport;
    private string conflict = "skip";
    private bool importSeparate = true; // default on: recreate the source calendars (Google export)
    private bool mergeByName = true;    // default on: merge files that share an X-WR-CALNAME
    private string? importMessage;
    private bool importing;   // an import is running — lock everything, including Close
    private bool importDone;  // an import finished — keep inputs locked; only Close stays active

    private bool showShare;
    private bool showRename;
    private string renameName = string.Empty;
    private string? renameError;
    private bool showDelete;
    private string moveTarget = string.Empty;
    private string? moveError;

    private bool IsZipSelected => pendingImport?.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) ?? false;
    private bool InputsLocked => importing || importDone;
    private string? SelectedCalendarName => calendars?.FirstOrDefault(c => c.Id == EffectiveId)?.Name;

    private void OpenImport()
    {
        pendingImport = null;
        importSeparate = true;
        mergeByName = true;
        importMessage = null;
        importing = false;
        importDone = false;
        showImport = true;
    }

    private ElementReference eventTable;
    private IJSObjectReference? columnModule;
    private IJSObjectReference? columnResizer;
    private bool resizerReady;

    private static readonly string[] WeekdayNames = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private Guid? EffectiveId => CalendarId ?? calendars?.FirstOrDefault()?.Id;

    private Guid? subscribedId;

    protected override void OnInitialized() => Live.CollectionChanged += OnCollectionChanged;

    protected override async Task OnParametersSetAsync()
    {
        calendars ??= await Api.GetCalendarsAsync();
        events = EffectiveId is { } id ? await Api.GetEventsAsync(id) : null;
        await LoadOccurrencesAsync();

        // Subscribe to live changes for the calendar being shown (ADR 0049).
        if (EffectiveId is { } shown && shown != subscribedId)
        {
            subscribedId = shown;
            await Live.SubscribeAsync(shown);
        }
    }

    // A live change to the shown calendar → reload its events (both list masters and grid occurrences).
    private void OnCollectionChanged(Guid collectionId)
    {
        if (collectionId == EffectiveId)
        {
            _ = InvokeAsync(async () =>
            {
                await ReloadEventsAsync();
                StateHasChanged();
            });
        }
    }

    // Grid occurrences for the visible window (ADR 0050): recurring events show on every date.
    private async Task LoadOccurrencesAsync()
    {
        if (EffectiveId is { } id && viewMode == View.Calendar)
        {
            var days = VisibleDays().ToList();
            var fromUtc = days.First().ToUniversalTime();
            var toUtc = days.Last().AddDays(1).ToUniversalTime();
            occurrences = await Api.GetEventOccurrencesAsync(id, fromUtc, toUtc);
        }
    }

    private async Task SetViewAsync(View view)
    {
        viewMode = view;
        await LoadOccurrencesAsync();
    }

    private async Task SetGridAsync(Grid grid)
    {
        gridMode = grid;
        await LoadOccurrencesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The list table is always in the DOM (hidden via CSS in calendar mode), so the resizer
        // initialises once and keeps its column widths across view switches.
        if (!resizerReady && events is not null)
        {
            resizerReady = true;
            columnModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/columnResize.js");
            columnResizer = await columnModule.InvokeAsync<IJSObjectReference>("init", eventTable);
        }
    }

    private void OnSwitch(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            Navigation.NavigateTo($"calendars/{id}");
        }
    }

    // --- List: sort + per-column filters ---
    private void Sort(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string Indicator(string column) => sortColumn == column ? (sortAscending ? "▲" : "▼") : "";

    private IEnumerable<EventDto> FilteredSorted()
    {
        var filtered = events!.Where(e =>
            FormatStart(e).Contains(fStart, StringComparison.OrdinalIgnoreCase)
            && (e.Summary ?? "").Contains(fTitle, StringComparison.OrdinalIgnoreCase)
            && (e.Location ?? "").Contains(fLocation, StringComparison.OrdinalIgnoreCase)
            && (!fRepeatsOnly || e.IsRecurring));

        IEnumerable<EventDto> ordered = sortColumn switch
        {
            "title" => filtered.OrderBy(e => e.Summary ?? "", StringComparer.OrdinalIgnoreCase),
            "location" => filtered.OrderBy(e => e.Location ?? "", StringComparer.OrdinalIgnoreCase),
            "repeats" => filtered.OrderBy(e => e.IsRecurring),
            _ => filtered.OrderBy(e => e.StartUtc ?? DateTime.MaxValue),
        };
        return sortAscending ? ordered : ordered.Reverse();
    }

    private static DateTime? LocalStart(EventDto e) => e.StartUtc?.ToLocalTime();

    private static string FormatStart(EventDto e) =>
        LocalStart(e) is { } s ? (e.IsAllDay ? s.ToString("ddd, d MMM yyyy") : s.ToString("ddd, d MMM yyyy HH:mm")) : "";

    private static string FormatRange(EventDto e)
    {
        if (LocalStart(e) is not { } s)
        {
            return "";
        }

        if (e.IsAllDay)
        {
            return s.ToString("ddd, d MMM yyyy") + " (all day)";
        }

        var end = e.EndUtc?.ToLocalTime();
        return end is { } en
            ? $"{s:ddd, d MMM yyyy HH:mm} – {(en.Date == s.Date ? en.ToString("HH:mm") : en.ToString("ddd, d MMM yyyy HH:mm"))}"
            : s.ToString("ddd, d MMM yyyy HH:mm");
    }

    private void Select(EventDto e)
    {
        selected = e;
        splittingId = null;
        moveTarget = string.Empty;
        moveError = null;
    }

    private void CloseDetail()
    {
        selected = null;
        splittingId = null;
        moveTarget = string.Empty;
        moveError = null;
    }

    // --- Rename / delete / move (ADR 0041, 0042) ---
    private void OpenRename()
    {
        renameName = SelectedCalendarName ?? string.Empty;
        renameError = null;
        showRename = true;
    }

    private async Task RenameAsync()
    {
        if (EffectiveId is not { } id || string.IsNullOrWhiteSpace(renameName))
        {
            return;
        }

        renameError = await Api.RenameCollectionAsync("calendars", id, renameName.Trim());
        if (renameError is null)
        {
            calendars = await Api.GetCalendarsAsync();
            showRename = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (EffectiveId is not { } id)
        {
            return;
        }

        await Api.DeleteCollectionAsync("calendars", id);
        showDelete = false;
        calendars = await Api.GetCalendarsAsync();
        Navigation.NavigateTo(calendars.FirstOrDefault()?.Id is { } first ? $"calendars/{first}" : "calendars");
    }

    private async Task MoveAsync(EventDto ev)
    {
        if (EffectiveId is not { } id || !Guid.TryParse(moveTarget, out var targetId))
        {
            return;
        }

        moveError = await Api.MoveEntryAsync("calendars", id, ev.Id, targetId);
        if (moveError is null)
        {
            CloseDetail();
            await ReloadEventsAsync();
        }
    }

    // --- Grid geometry ---
    private static DateTime WeekStart(DateTime d) => d.Date.AddDays(-((int)d.DayOfWeek + 6) % 7); // Monday-based

    private IEnumerable<DateTime> VisibleDays()
    {
        if (gridMode == Grid.Week)
        {
            var weekStart = WeekStart(cursor);
            return Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i));
        }

        var first = new DateTime(cursor.Year, cursor.Month, 1);
        var gridStart = WeekStart(first);
        return Enumerable.Range(0, 42).Select(i => gridStart.AddDays(i)); // 6 weeks
    }

    private IEnumerable<EventDto> EventsOn(DateTime day) =>
        (occurrences ?? []).Where(e => LocalStart(e)?.Date == day.Date).OrderBy(e => e.StartUtc);

    private string PeriodLabel => gridMode == Grid.Week
        ? $"{WeekStart(cursor):d MMM} – {WeekStart(cursor).AddDays(6):d MMM yyyy}"
        : cursor.ToString("MMMM yyyy");

    private async Task Prev()
    {
        cursor = gridMode == Grid.Week ? cursor.AddDays(-7) : cursor.AddMonths(-1);
        await LoadOccurrencesAsync();
    }

    private async Task Next()
    {
        cursor = gridMode == Grid.Week ? cursor.AddDays(7) : cursor.AddMonths(1);
        await LoadOccurrencesAsync();
    }

    private async Task Today()
    {
        cursor = DateTime.Today;
        await LoadOccurrencesAsync();
    }

    // --- Split (ADR 0027): only timed, non-recurring events with a real window ---
    private static bool CanSplit(EventDto e) =>
        !e.IsAllDay && !e.IsRecurring && e.StartUtc is { } s && e.EndUtc is { } end && end > s;

    private void BeginSplit(EventDto e)
    {
        splittingId = e.Id;
        splitAt = (e.StartUtc!.Value + (e.EndUtc!.Value - e.StartUtc!.Value) / 2).ToLocalTime();
    }

    private void CancelSplit() => splittingId = null;

    private async Task ConfirmSplitAsync(EventDto e)
    {
        if (EffectiveId is not { } id)
        {
            return;
        }

        await Api.SplitEventAsync(id, e.Id, DateTime.SpecifyKind(splitAt.ToUniversalTime(), DateTimeKind.Utc));
        splittingId = null;
        CloseDetail();
        await ReloadEventsAsync();
    }

    // --- Event editor (create + edit), ADR 0050 ---
    private void OpenNew()
    {
        editingId = null;
        summary = attendees = location = string.Empty;
        start = DateTime.Now;
        end = DateTime.Now.AddHours(1);
        isAllDay = false;
        ResetRecurrence();
        editorError = null;
        showEditor = true;
    }

    private async Task OpenEditAsync(EventDto clicked)
    {
        if (EffectiveId is not { } id)
        {
            return;
        }

        // Always edit the series master (a clicked grid item may be an expanded occurrence).
        var ev = await Api.GetEventAsync(id, clicked.Id) ?? clicked;
        editingId = ev.Id;
        summary = ev.Summary ?? string.Empty;
        location = ev.Location ?? string.Empty;
        isAllDay = ev.IsAllDay;
        start = (ev.StartUtc ?? DateTime.UtcNow).ToLocalTime();
        end = ev.EndUtc?.ToLocalTime();
        attendees = string.Join(", ", (ev.Attendees ?? []).Where(a => !a.IsOrganizer).Select(a => a.Address.Replace("mailto:", "")));
        ResetRecurrence();

        if (ev is { RecurrenceSupported: true, Recurrence: { } r })
        {
            repeatFreq = r.Frequency;
            repeatInterval = Math.Max(1, r.Interval);
            foreach (var d in r.ByDay)
            {
                repeatDays.Add(d);
            }

            (repeatEnd, repeatUntil, repeatCount) = r switch
            {
                { Count: { } n } => ("count", (DateTime?)null, (int?)n),
                { UntilUtc: { } u } => ("until", u.ToLocalTime(), null),
                _ => ("never", null, null),
            };
        }
        else if (!string.IsNullOrWhiteSpace(ev.RecurrenceRule))
        {
            customRuleMode = true;
            customRule = ev.RecurrenceRule;
        }

        selected = null;
        editorError = null;
        showEditor = true;
    }

    private void CloseEditor() => showEditor = false;

    private void ResetRecurrence()
    {
        repeatFreq = string.Empty;
        repeatInterval = 1;
        repeatDays.Clear();
        repeatEnd = "never";
        repeatUntil = null;
        repeatCount = null;
        customRuleMode = false;
        customRule = null;
    }

    private void ToggleDay(string code)
    {
        if (!repeatDays.Remove(code))
        {
            repeatDays.Add(code);
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(summary) || EffectiveId is not { } id)
        {
            return;
        }

        editorError = null;
        var startUtc = DateTime.SpecifyKind(start.ToUniversalTime(), DateTimeKind.Utc);
        var endUtc = end is { } e ? DateTime.SpecifyKind(e.ToUniversalTime(), DateTimeKind.Utc) : (DateTime?)null;
        var invitees = attendees.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        var body = new Dictionary<string, object?>
        {
            ["summary"] = summary,
            ["startUtc"] = startUtc,
            ["endUtc"] = endUtc,
            ["isAllDay"] = isAllDay,
            ["location"] = string.IsNullOrWhiteSpace(location) ? null : location,
            ["attendees"] = invitees.Select(a => new { address = a }).ToList(),
        };

        if (customRuleMode)
        {
            body["recurrenceRule"] = customRule; // preserve the imported rule verbatim
        }
        else if (repeatFreq.Length > 0)
        {
            body["recurrence"] = new
            {
                frequency = repeatFreq,
                interval = Math.Max(1, repeatInterval),
                byDay = repeatFreq == "WEEKLY" ? repeatDays.ToList() : new List<string>(),
                count = repeatEnd == "count" ? repeatCount : null,
                untilUtc = repeatEnd == "until" && repeatUntil is { } u
                    ? DateTime.SpecifyKind(u.ToUniversalTime(), DateTimeKind.Utc)
                    : (DateTime?)null,
            };
        }

        try
        {
            if (editingId is { } existing)
            {
                await Api.UpdateEventAsync(id, existing, body);
            }
            else
            {
                await Api.CreateEventAsync(id, body);
            }
        }
        catch (HttpRequestException ex)
        {
            editorError = $"Save failed: {ex.Message}";
            return;
        }

        showEditor = false;
        await ReloadEventsAsync();
    }

    private static string RecurrenceText(EventDto e)
    {
        if (e is { RecurrenceSupported: true, Recurrence: { } r })
        {
            var unit = r.Frequency switch
            {
                "DAILY" => "day", "WEEKLY" => "week", "MONTHLY" => "month", "YEARLY" => "year", _ => "time",
            };
            var text = r.Interval == 1 ? $"Every {unit}" : $"Every {r.Interval} {unit}s";
            if (r.Frequency == "WEEKLY" && r.ByDay.Count > 0)
            {
                text += $" on {string.Join(", ", r.ByDay)}";
            }

            if (r.Count is { } n)
            {
                text += $", {n} times";
            }
            else if (r.UntilUtc is { } u)
            {
                text += $", until {u.ToLocalTime():d MMM yyyy}";
            }

            return text;
        }

        return e.RecurrenceRule is { } rule ? $"Custom rule ({rule})" : "Repeats";
    }

    // --- Import / export ---

    private void OnImportFile(InputFileChangeEventArgs e) => pendingImport = e.File;

    private async Task ImportAsync()
    {
        if (pendingImport is null || EffectiveId is not { } id)
        {
            return;
        }

        importing = true;
        try
        {
            using var buffer = new MemoryStream();
            await pendingImport.OpenReadStream(64 * 1024 * 1024).CopyToAsync(buffer);
            var result = await Api.ImportCollectionAsync("calendars", id, buffer.ToArray(), pendingImport.Name, conflict, importSeparate, mergeByName);
            importMessage = result is { CreatedCollections: > 0 }
                ? $"Created {result.CreatedCollections} calendar(s); imported {result.Imported}, skipped {result.Skipped}, failed {result.Failed}."
                : $"Imported {result?.Imported}, skipped {result?.Skipped}, failed {result?.Failed}.";
            importDone = true; // lock the inputs; the user can now only Close
            if (result is { CreatedCollections: > 0 })
            {
                calendars = await Api.GetCalendarsAsync(); // new calendars appear in the switcher
            }

            await ReloadEventsAsync();
        }
        finally
        {
            importing = false;
        }
    }

    private async Task ExportAsync()
    {
        if (EffectiveId is { } id)
        {
            var bytes = await Api.ExportCollectionAsync("calendars", id);
            await JS.InvokeVoidAsync("simplDownload", "calendar.ics", "text/calendar", Convert.ToBase64String(bytes));
        }
    }

    private async Task ReloadEventsAsync()
    {
        if (EffectiveId is { } id)
        {
            events = await Api.GetEventsAsync(id);
            await LoadOccurrencesAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.CollectionChanged -= OnCollectionChanged;
        try
        {
            if (columnResizer is not null)
            {
                await columnResizer.InvokeVoidAsync("dispose");
                await columnResizer.DisposeAsync();
            }

            if (columnModule is not null)
            {
                await columnModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone — nothing to clean up.
        }
    }
}
