    private IEnumerable<CalendarDto> Visible() => (calendars ?? []).Where(c => checkedIds.Contains(c.Id));

    private async Task ReloadAllAsync()
    {
        if (calendars is null)
        {
            return;
        }

        var list = new List<CalEntry>();
        foreach (var c in Visible())
        {
            var color = CollectionColors.Effective(c.Id, c.MyColor, c.Color);
            foreach (var e in await Api.GetEventsAsync(c.Id))
            {
                list.Add(new CalEntry(e, c.Id, c.Name, color));
            }
        }

        entries = list;
        await LoadOccurrencesAsync();
    }

    // Grid occurrences for the visible window (ADR 0050), merged across checked calendars.
    private async Task LoadOccurrencesAsync()
    {
        if (calendars is null || viewMode != View.Calendar)
        {
            return;
        }

        var days = VisibleDays().ToList();
        var fromUtc = days.First().ToUniversalTime();
        var toUtc = days.Last().AddDays(1).ToUniversalTime();

        var occ = new List<CalEntry>();
        foreach (var c in Visible())
        {
            var color = CollectionColors.Effective(c.Id, c.MyColor, c.Color);
            foreach (var e in await Api.GetEventOccurrencesAsync(c.Id, fromUtc, toUtc))
            {
                occ.Add(new CalEntry(e, c.Id, c.Name, color));
            }
        }

        occEntries = occ;
    }

    private async Task SubscribeCheckedAsync()
    {
        foreach (var id in checkedIds.Where(id => !subscribedIds.Contains(id)).ToList())
        {
            subscribedIds.Add(id);
            await Live.SubscribeAsync(id);
        }
    }

