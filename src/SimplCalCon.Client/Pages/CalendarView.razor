@page "/calendars/{CalendarId:guid}"
@attribute [Authorize]
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>Calendar</PageTitle>

<h1>Agenda</h1>
<p><a href="">← Collections</a> · <a href="share/calendars/@CalendarId">Share</a> · <a href="trash/calendars/@CalendarId">Trash</a></p>

@if (events is null)
{
    <p>Loading…</p>
}
else
{
    @foreach (var day in events.Where(e => e.StartUtc is not null).GroupBy(e => e.StartUtc!.Value.Date).OrderBy(g => g.Key))
    {
        <h3>@day.Key.ToString("ddd, d MMM yyyy")</h3>
        <ul>
            @foreach (var item in day.OrderBy(e => e.StartUtc))
            {
                <li>
                    @(item.IsAllDay ? "All day" : item.StartUtc!.Value.ToString("HH:mm")) — @item.Summary@(item.IsRecurring ? " ↻" : "")
                    @if (item.Attendees is { Count: > 0 } people)
                    {
                        <span class="attendees"> — @string.Join(", ", people.Where(p => !p.IsOrganizer).Select(p => $"{p.CommonName ?? p.Address} ({p.ParticipationStatus})"))</span>
                    }
                    <a href="history/calendars/@CalendarId/@item.Id">History</a>
                    @if (CanSplit(item))
                    {
                        @if (splittingId == item.Id)
                        {
                            <input type="datetime-local" @bind="splitAt" />
                            <button @onclick="() => ConfirmSplitAsync(item)">Split here</button>
                            <button @onclick="CancelSplit">Cancel</button>
                        }
                        else
                        {
                            <button @onclick="() => BeginSplit(item)">Split</button>
                        }
                    }
                </li>
            }
        </ul>
    }
    @if (events.Count == 0)
    {
        <p>No events.</p>
    }

    <h2>New event</h2>
    <div>
        <input placeholder="Summary" @bind="summary" />
        <input type="datetime-local" @bind="start" />
        <input placeholder="Attendees (comma-separated emails)" @bind="attendees" />
        <button @onclick="AddAsync">Add</button>
    </div>

    <h2>Import / export</h2>
    <div>
        <InputFile OnChange="OnImportFile" accept=".ics" />
        <select @bind="conflict">
            <option value="skip">Skip duplicates</option>
            <option value="replace">Replace duplicates</option>
        </select>
        <button @onclick="ImportAsync" disabled="@(pendingImport is null)">Import</button>
        <button @onclick="ExportAsync">Export .ics</button>
    </div>
    @if (importMessage is not null)
    {
        <p>@importMessage</p>
    }
}

@code {
    [Parameter]
    public Guid CalendarId { get; set; }

    private IReadOnlyList<EventDto>? events;
    private string summary = string.Empty;
    private string attendees = string.Empty;
    private DateTime start = DateTime.UtcNow;
    private Guid? splittingId;
    private DateTime splitAt;
    private IBrowserFile? pendingImport;
    private string conflict = "skip";
    private string? importMessage;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync() => events = await Api.GetEventsAsync(CalendarId);

    // Only timed, non-recurring events with a start/end window can be split (ADR 0027).
    private static bool CanSplit(EventDto e) =>
        !e.IsAllDay && !e.IsRecurring && e.StartUtc is { } s && e.EndUtc is { } end && end > s;

    private void BeginSplit(EventDto e)
    {
        splittingId = e.Id;
        splitAt = e.StartUtc!.Value + (e.EndUtc!.Value - e.StartUtc!.Value) / 2;
    }

    private void CancelSplit() => splittingId = null;

    private async Task ConfirmSplitAsync(EventDto e)
    {
        await Api.SplitEventAsync(CalendarId, e.Id, DateTime.SpecifyKind(splitAt, DateTimeKind.Utc));
        splittingId = null;
        await LoadAsync();
    }

    private void OnImportFile(InputFileChangeEventArgs e) => pendingImport = e.File;

    private async Task ImportAsync()
    {
        if (pendingImport is null)
        {
            return;
        }

        using var buffer = new MemoryStream();
        await pendingImport.OpenReadStream(32 * 1024 * 1024).CopyToAsync(buffer);
        var result = await Api.ImportCollectionAsync("calendars", CalendarId, buffer.ToArray(), pendingImport.Name, conflict);
        importMessage = $"Imported {result?.Imported}, skipped {result?.Skipped}, failed {result?.Failed}.";
        pendingImport = null;
        await LoadAsync();
    }

    private async Task ExportAsync()
    {
        var bytes = await Api.ExportCollectionAsync("calendars", CalendarId);
        await JS.InvokeVoidAsync("simplDownload", "calendar.ics", "text/calendar", Convert.ToBase64String(bytes));
    }

    private async Task AddAsync()
    {
        if (!string.IsNullOrWhiteSpace(summary))
        {
            var invitees = attendees.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            await Api.CreateEventAsync(CalendarId, summary, DateTime.SpecifyKind(start, DateTimeKind.Utc), null, false, invitees);
            summary = string.Empty;
            attendees = string.Empty;
            await LoadAsync();
        }
    }
}
