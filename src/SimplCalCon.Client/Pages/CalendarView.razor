    // --- List: sort + per-column filters ---
    private void Sort(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string Indicator(string column) => sortColumn == column ? (sortAscending ? "▲" : "▼") : "";

    private IEnumerable<CalEntry> FilteredSorted()
    {
        var filtered = entries!.Where(e =>
            e.CalName.Contains(fCollection, StringComparison.OrdinalIgnoreCase)
            && FormatStart(e.Event).Contains(fStart, StringComparison.OrdinalIgnoreCase)
            && (e.Event.Summary ?? "").Contains(fTitle, StringComparison.OrdinalIgnoreCase)
            && (e.Event.Location ?? "").Contains(fLocation, StringComparison.OrdinalIgnoreCase)
            && (!fRepeatsOnly || e.Event.IsRecurring));

        IEnumerable<CalEntry> ordered = sortColumn switch
        {
            "collection" => filtered.OrderBy(e => e.CalName, StringComparer.OrdinalIgnoreCase),
            "title" => filtered.OrderBy(e => e.Event.Summary ?? "", StringComparer.OrdinalIgnoreCase),
            "location" => filtered.OrderBy(e => e.Event.Location ?? "", StringComparer.OrdinalIgnoreCase),
            "repeats" => filtered.OrderBy(e => e.Event.IsRecurring),
            _ => filtered.OrderBy(e => e.Event.StartUtc ?? DateTime.MaxValue),
        };
        return sortAscending ? ordered : ordered.Reverse();
    }

    // --- Bulk selection (ADR 0055) ---
    private bool AllSelected => FilteredSorted().Any() && FilteredSorted().All(e => selectedIds.Contains(e.Event.Id));

    private void ToggleSelected(Guid id)
    {
        if (!selectedIds.Remove(id))
        {
            selectedIds.Add(id);
        }

        bulkMessage = null;
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var all = FilteredSorted().Select(x => x.Event.Id).ToList();
        if (e.Value is true && !all.All(selectedIds.Contains))
        {
            foreach (var id in all)
            {
                selectedIds.Add(id);
            }
        }
        else
        {
            foreach (var id in all)
            {
                selectedIds.Remove(id);
            }
        }
    }

    private void ClearSelection()
    {
        selectedIds.Clear();
        bulkTarget = string.Empty;
        bulkMessage = null;
    }

    // Selected events may span calendars; group by their source calendar for the per-collection bulk API.
    private Dictionary<Guid, List<Guid>> SelectedByCalendar() =>
        (entries ?? [])
            .Where(e => selectedIds.Contains(e.Event.Id))
            .GroupBy(e => e.CalId)
            .ToDictionary(g => g.Key, g => g.Select(e => e.Event.Id).ToList());

    private async Task BulkDeleteAsync()
    {
        if (selectedIds.Count == 0)
        {
            return;
        }

        bulkBusy = true;
        try
        {
            int ok = 0, failed = 0;
            foreach (var (calId, ids) in SelectedByCalendar())
            {
                var result = await Api.BulkDeleteAsync("calendars", calId, ids);
                ok += result?.Succeeded ?? 0;
                failed += result?.Failed ?? ids.Count;
            }

            bulkMessage = $"Deleted {ok}{(failed > 0 ? $", {failed} failed" : "")}.";
            selectedIds.Clear();
            await ReloadAllAsync();
        }
        finally
        {
            bulkBusy = false;
        }
    }

    private async Task BulkMoveAsync()
    {
        if (selectedIds.Count == 0 || !Guid.TryParse(bulkTarget, out var target))
        {
            return;
        }

        bulkBusy = true;
        try
        {
            int ok = 0, failed = 0;
            foreach (var (calId, ids) in SelectedByCalendar())
            {
                if (calId == target)
                {
                    continue; // already there
                }

                var result = await Api.BulkMoveAsync("calendars", calId, ids, target);
                ok += result?.Succeeded ?? 0;
                failed += result?.Failed ?? ids.Count;
            }

            bulkMessage = $"Moved {ok}{(failed > 0 ? $", {failed} failed" : "")}.";
            selectedIds.Clear();
            bulkTarget = string.Empty;
            await ReloadAllAsync();
        }
        finally
        {
            bulkBusy = false;
        }
    }

    private static DateTime? LocalStart(EventDto e) => e.StartUtc?.ToLocalTime();

    private static string FormatStart(EventDto e) =>
        LocalStart(e) is { } s ? (e.IsAllDay ? s.ToString("ddd, d MMM yyyy") : s.ToString("ddd, d MMM yyyy HH:mm")) : "";

    private static string FormatRange(EventDto e)
    {
        if (LocalStart(e) is not { } s)
        {
            return "";
        }

        if (e.IsAllDay)
        {
            return s.ToString("ddd, d MMM yyyy") + " (all day)";
        }

        var end = e.EndUtc?.ToLocalTime();
        return end is { } en
            ? $"{s:ddd, d MMM yyyy HH:mm} – {(en.Date == s.Date ? en.ToString("HH:mm") : en.ToString("ddd, d MMM yyyy HH:mm"))}"
            : s.ToString("ddd, d MMM yyyy HH:mm");
    }

