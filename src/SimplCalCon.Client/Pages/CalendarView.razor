@page "/calendars/{CalendarId:guid?}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject LiveUpdates Live

<PageTitle>Calendar</PageTitle>

@if (calendars is { Count: > 0 })
{
    <SectionContent SectionName="RibbonSection">
        <button class="ribbon-btn @(viewMode == View.List ? "active" : "")" @onclick="() => viewMode = View.List">List</button>
        <button class="ribbon-btn @(viewMode == View.Calendar ? "active" : "")" @onclick="() => SetViewAsync(View.Calendar)">Calendar</button>
        <button @onclick="OpenNew" disabled="@(EffectiveId is null)">New event</button>
        <button @onclick="OpenImport" disabled="@(EffectiveId is null)">Import</button>
        <button @onclick="ExportAsync" disabled="@(EffectiveId is null)">Export .ics</button>
        @if (EffectiveId is { } id)
        {
            <button @onclick="OpenRename">Rename</button>
            <button @onclick="() => showDelete = true">Delete</button>
            <button @onclick="() => showShare = true">Share</button>
            <a class="ribbon-btn" href="trash/calendars/@id">Trash</a>
        }
        <a class="ribbon-btn" href="invitations">Invitations</a>
    </SectionContent>
}

@if (calendars is null)
{
    <p>Loading…</p>
}
else if (calendars.Count == 0)
{
    <p>No calendars yet — create one on the <a href="">Overview</a> tab.</p>
}
else
{
    <div class="cal-layout">
        <CollectionsPane Heading="Calendars"
                         EmptyText="No calendars."
                         Collections="PaneItems()"
                         Checked="checkedIds"
                         ActiveId="activeId"
                         OnFilterChanged="OnFilterChangedAsync"
                         OnActiveChanged="OnActiveChangedAsync"
                         OnColorChanged="OnColorChangedAsync"
                         OnColorReset="OnColorResetAsync" />

        <div class="cal-main">
            @if (entries is null)
            {
                <p>Loading…</p>
            }
            else
            {
                <div class="cal-list @(viewMode == View.List ? "" : "hidden")">
                    @if (selectedIds.Count > 0)
                    {
                        <div class="bulk-bar">
                            <span>@selectedIds.Count selected</span>
                            @if (calendars is { Count: > 1 })
                            {
                                <select @bind="bulkTarget">
                                    <option value="">Move to…</option>
                                    @foreach (var c in calendars)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </select>
                                <button @onclick="BulkMoveAsync" disabled="@(string.IsNullOrEmpty(bulkTarget) || bulkBusy)">Move</button>
                            }
                            <button class="danger" @onclick="BulkDeleteAsync" disabled="@bulkBusy">Delete</button>
                            <button @onclick="ClearSelection">Clear</button>
                            @if (bulkMessage is not null)
                            {
                                <span class="bulk-message">@bulkMessage</span>
                            }
                        </div>
                    }
                    <table @ref="eventTable" class="event-table">
                        <thead>
                            <tr>
                                <th class="sel-col"><input type="checkbox" checked="@AllSelected" @onchange="ToggleSelectAll" /></th>
                                <th class="color-col">•</th>
                                <th @onclick='() => Sort("collection")'>Calendar <span class="sort">@Indicator("collection")</span></th>
                                <th @onclick='() => Sort("start")'>Start <span class="sort">@Indicator("start")</span></th>
                                <th @onclick='() => Sort("title")'>Title <span class="sort">@Indicator("title")</span></th>
                                <th @onclick='() => Sort("location")'>Location <span class="sort">@Indicator("location")</span></th>
                                <th class="repeats-col" @onclick='() => Sort("repeats")'>Repeats <span class="sort">@Indicator("repeats")</span></th>
                            </tr>
                            <tr class="filter-row">
                                <th class="sel-col"></th>
                                <th class="color-col"></th>
                                <th><FilterInput @bind-Value="fCollection" /></th>
                                <th><FilterInput @bind-Value="fStart" /></th>
                                <th><FilterInput @bind-Value="fTitle" /></th>
                                <th><FilterInput @bind-Value="fLocation" /></th>
                                <th class="repeats-col">
                                    <label title="Show only recurring events"><input type="checkbox" @bind="fRepeatsOnly" /> only</label>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in FilteredSorted())
                            {
                                <tr @key="e.Event.Id" class="@(selected?.Id == e.Event.Id ? "sel" : "")" @onclick="() => Select(e)">
                                    <td class="sel-col" @onclick:stopPropagation>
                                        <input type="checkbox" checked="@selectedIds.Contains(e.Event.Id)" @onchange="() => ToggleSelected(e.Event.Id)" />
                                    </td>
                                    <td class="color-col"><span class="swatch" style="background:@e.Color"></span></td>
                                    <td>@e.CalName</td>
                                    <td>@FormatStart(e.Event)</td>
                                    <td>@e.Event.Summary</td>
                                    <td>@e.Event.Location</td>
                                    <td class="repeats-col">@(e.Event.IsRecurring ? "↻" : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (entries.Count == 0)
                    {
                        <p>No events in the shown calendars.</p>
                    }
                </div>

                @if (viewMode == View.Calendar)
                {
                    <div class="cal-grid-wrap">
                        <div class="grid-controls">
                            <button @onclick="Prev" title="Previous">‹</button>
                            <button @onclick="Today">Today</button>
                            <button @onclick="Next" title="Next">›</button>
                            <span class="period-label">@PeriodLabel</span>
                            <span class="grid-spacer"></span>
                            <button class="@(gridMode == Grid.Month ? "active" : "")" @onclick="() => SetGridAsync(Grid.Month)">Month</button>
                            <button class="@(gridMode == Grid.Week ? "active" : "")" @onclick="() => SetGridAsync(Grid.Week)">Week</button>
                        </div>

                        <div class="grid-weekdays">
                            @foreach (var name in WeekdayNames)
                            {
                                <div class="weekday">@name</div>
                            }
                        </div>

                        <div class="@(gridMode == Grid.Month ? "month-grid" : "week-grid")">
                            @foreach (var day in VisibleDays())
                            {
                                <div class="day-cell @(day.Month != cursor.Month && gridMode == Grid.Month ? "other-month" : "") @(day == DateTime.Today ? "today" : "")">
                                    <div class="day-number">@day.Day</div>
                                    @foreach (var e in EventsOn(day))
                                    {
                                        <button class="event-chip" style="border-left:4px solid @e.Color" title="@($"{e.Event.Summary} · {e.CalName}")" @onclick="() => Select(e)">
                                            <span class="chip-time">@(e.Event.IsAllDay ? "—" : LocalStart(e.Event)?.ToString("HH:mm"))</span> @e.Event.Summary
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

<Modal Visible="showEditor" Title="@(editingId is null ? "New event" : "Edit event")" OnClose="CloseEditor">
    <div class="form-row"><label>Summary</label><input @bind="summary" /></div>
    <label class="form-check"><input type="checkbox" @bind="isAllDay" /> <span>All day</span></label>
    <div class="form-row"><label>Start</label><input type="datetime-local" @bind="start" /></div>
    <div class="form-row"><label>End</label><input type="datetime-local" @bind="end" /></div>
    <div class="form-row"><label>Location</label><input @bind="location" /></div>
    <div class="form-row"><label>Attendees</label><input placeholder="comma-separated emails" @bind="attendees" /></div>

    @* Editing a single occurrence ("this event") has no repeat rule of its own. *@
    @if (editScope == "this")
    {
        <div class="form-row"><label>Repeats</label><span>This occurrence only</span></div>
    }
    else if (customRuleMode)
    {
        <div class="form-row">
            <label>Repeats</label>
            <span class="custom-rule" title="Edit this rule in a native calendar client">Custom rule (@customRule)</span>
        </div>
    }
    else
    {
        <div class="form-row">
            <label>Repeats</label>
            <select @bind="repeatFreq">
                <option value="">Does not repeat</option>
                <option value="DAILY">Daily</option>
                <option value="WEEKLY">Weekly</option>
                <option value="MONTHLY">Monthly</option>
                <option value="YEARLY">Yearly</option>
            </select>
        </div>
        @if (repeatFreq.Length > 0)
        {
            <div class="form-row">
                <label>Every</label>
                <input type="number" min="1" class="interval" @bind="repeatInterval" />
                <span>@FreqUnit</span>
            </div>
            @if (repeatFreq == "WEEKLY")
            {
                <div class="form-row">
                    <label>On</label>
                    <div class="weekday-toggles">
                        @foreach (var (code, name) in Weekdays)
                        {
                            <button type="button" class="wd @(repeatDays.Contains(code) ? "on" : "")"
                                    @onclick="() => ToggleDay(code)">@name</button>
                        }
                    </div>
                </div>
            }
            @if (repeatFreq == "MONTHLY")
            {
                <div class="form-row">
                    <label>On</label>
                    <select @bind="monthlyMode">
                        <option value="day">Day of the month</option>
                        <option value="weekday">A weekday of the month</option>
                    </select>
                </div>
                @if (monthlyMode == "day")
                {
                    <div class="form-row">
                        <label>Day</label>
                        <input type="number" min="1" max="31" class="interval" @bind="monthlyDay" />
                    </div>
                }
                else
                {
                    <div class="form-row">
                        <label>The</label>
                        <select @bind="monthlyOrdinal">
                            <option value="1">first</option>
                            <option value="2">second</option>
                            <option value="3">third</option>
                            <option value="4">fourth</option>
                            <option value="-1">last</option>
                        </select>
                        <select @bind="monthlyWeekday">
                            @foreach (var wd in Weekdays)
                            {
                                <option value="@wd.Code">@wd.Name</option>
                            }
                        </select>
                    </div>
                }
            }
            <div class="form-row">
                <label>Ends</label>
                <select @bind="repeatEnd">
                    <option value="never">Never</option>
                    <option value="until">On date</option>
                    <option value="count">After N times</option>
                </select>
                @if (repeatEnd == "until")
                {
                    <input type="date" @bind="repeatUntil" />
                }
                else if (repeatEnd == "count")
                {
                    <input type="number" min="1" class="interval" @bind="repeatCount" /> <span>times</span>
                }
            </div>
        }
    }

    @if (editorError is not null)
    {
        <p class="import-message">@editorError</p>
    }
    <div class="form-actions">
        <button @onclick="SaveAsync" disabled="@string.IsNullOrWhiteSpace(summary)">Save</button>
        <button @onclick="CloseEditor">Cancel</button>
    </div>
</Modal>

<Modal Visible="showImport" Title="Import calendar (.ics or .zip)" CloseDisabled="@importing" OnClose="() => showImport = false">
    <div class="form-row"><InputFile OnChange="OnImportFile" accept=".ics,.zip" disabled="@InputsLocked" /></div>
    @if (IsZipSelected)
    {
        <label class="form-check" title="Recreate the original calendars from the archive (e.g. a Google export)">
            <input type="checkbox" @bind="importSeparate" disabled="@InputsLocked" />
            <span>Create a separate calendar for each file in the archive</span>
        </label>
        @if (importSeparate)
        {
            <label class="form-check" title="Files that resolve to the same calendar name are merged into one calendar">
                <input type="checkbox" @bind="mergeByName" disabled="@InputsLocked" />
                <span>Assign entries by their X-WR-CALNAME — don't create multiple calendars with the same name</span>
            </label>
        }
    }
    <div class="form-row">
        <label>On conflict</label>
        <select @bind="conflict" disabled="@InputsLocked">
            <option value="skip">Skip duplicates</option>
            <option value="replace">Replace duplicates</option>
        </select>
    </div>
    <div class="form-actions">
        <button @onclick="ImportAsync" disabled="@(pendingImport is null || InputsLocked)">Import</button>
        <button @onclick="() => showImport = false" disabled="@importing">Close</button>
    </div>
    @if (importing)
    {
        <p class="import-message">Importing…</p>
    }
    else if (importMessage is not null)
    {
        <p class="import-message">@importMessage</p>
    }
</Modal>

<Modal Visible="selected is not null" Title="@(selected?.Summary ?? "Event")" OnClose="CloseDetail">
    @if (selected is { } ev)
    {
        <dl class="detail">
            <dt>Calendar</dt>
            <dd><span class="swatch" style="background:@selectedColor"></span> @selectedCalName</dd>
            <dt>When</dt>
            <dd>@FormatRange(ev)</dd>
            @if (ev.IsRecurring)
            {
                <dt>Repeats</dt>
                <dd>@RecurrenceText(ev)</dd>
            }
            @if (!string.IsNullOrWhiteSpace(ev.Location))
            {
                <dt>Location</dt>
                <dd>@ev.Location</dd>
            }
            @if (ev.Attendees is { Count: > 0 } people)
            {
                <dt>Attendees</dt>
                <dd>@string.Join(", ", people.Where(p => !p.IsOrganizer).Select(p => $"{p.CommonName ?? p.Address} ({p.ParticipationStatus})"))</dd>
            }
        </dl>
        <div class="form-actions">
            <button @onclick="() => EditClickedAsync(ev)">Edit</button>
            <button class="danger" @onclick="() => DeleteClickedAsync(ev)">Delete</button>
            @if (selectedCalId is { } scid)
            {
                <a class="ribbon-btn" href="history/calendars/@scid/@ev.Id">History</a>
            }
            @if (CanSplit(ev))
            {
                @if (splittingId == ev.Id)
                {
                    <input type="datetime-local" @bind="splitAt" />
                    <button @onclick="() => ConfirmSplitAsync(ev)">Split here</button>
                    <button @onclick="CancelSplit">Cancel</button>
                }
                else
                {
                    <button @onclick="() => BeginSplit(ev)">Split</button>
                }
            }
        </div>
        @if (calendars is { Count: > 1 })
        {
            <div class="form-row">
                <label>Move to</label>
                <select @bind="moveTarget">
                    <option value="">— choose calendar —</option>
                    @foreach (var c in calendars.Where(c => c.Id != selectedCalId))
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <button @onclick="() => MoveAsync(ev)" disabled="@string.IsNullOrEmpty(moveTarget)">Move</button>
            </div>
            @if (moveError is not null)
            {
                <p class="import-message">@moveError</p>
            }
        }
    }
</Modal>

<Modal Visible="scopeAction.Length > 0" Title="@(scopeAction == "edit" ? "Edit recurring event" : "Delete recurring event")" OnClose="CancelScope">
    <p>This is a repeating event. Apply to:</p>
    <div class="scope-choices">
        <button @onclick='() => ChooseScope("this")'>This event</button>
        <button @onclick='() => ChooseScope("following")'>This and following events</button>
        <button @onclick='() => ChooseScope("all")'>All events in the series</button>
    </div>
    <div class="form-actions"><button @onclick="CancelScope">Cancel</button></div>
</Modal>

<Modal Visible="showShare" Title="Share calendar" OnClose="() => showShare = false">
    @if (EffectiveId is { } sid)
    {
        <ShareEditor Kind="calendars" CollectionId="sid" />
    }
</Modal>

<Modal Visible="showRename" Title="Edit calendar" OnClose="() => showRename = false">
    <div class="form-row"><label>Name</label><input @bind="renameName" placeholder="Calendar name" /></div>
    <div class="form-row">
        <label>Default colour</label>
        <input type="color" @bind="renameColor" />
        <span class="hint">Shared with everyone; each person can still pick their own.</span>
    </div>
    <div class="form-row">
        <label>Subscription</label>
        @if (ActiveCalendar?.FeedToken is { } token && EffectiveId is { } fid)
        {
            <div class="feed-box">
                <input class="feed-url" readonly value="@FeedUrl("calendars", fid, token, "ics")" />
                <button type="button" @onclick='() => CopyAsync(FeedUrl("calendars", fid, token, "ics"))'>Copy</button>
                <button type="button" @onclick="ResetFeedAsync">Reset</button>
                <button type="button" class="danger" @onclick="DisableFeedAsync">Disable</button>
                <span class="hint">Read-only. Paste into Outlook/Apple/Google/Thunderbird as an internet calendar (webcal:// also works).</span>
            </div>
        }
        else
        {
            <button type="button" @onclick="EnableFeedAsync">Enable subscription link</button>
        }
    </div>
    <div class="form-actions">
        <button @onclick="RenameAsync" disabled="@string.IsNullOrWhiteSpace(renameName)">Save</button>
        <button @onclick="() => showRename = false">Cancel</button>
    </div>
    @if (renameError is not null)
    {
        <p class="import-message">@renameError</p>
    }
</Modal>

<Modal Visible="showDelete" Title="Delete calendar" OnClose="() => showDelete = false">
    <p>Delete calendar “<strong>@ActiveCalendarName</strong>”? Its events will no longer appear. This can be undone by an administrator.</p>
    <div class="form-actions">
        <button class="danger" @onclick="DeleteAsync">Delete</button>
        <button @onclick="() => showDelete = false">Cancel</button>
    </div>
</Modal>

@code {
    private enum View { List, Calendar }
    private enum Grid { Month, Week }

    [Parameter]
    public Guid? CalendarId { get; set; }

    // One shown event tagged with its owning calendar (ADR 0062).
    private sealed record CalEntry(EventDto Event, Guid CalId, string CalName, string Color);

    private IReadOnlyList<CalendarDto>? calendars;
    private readonly HashSet<Guid> checkedIds = [];   // visible collections (the filter)
    private Guid? activeId;                            // action target (New/Import/Share/…)
    private bool stateLoaded;

    private List<CalEntry>? entries;      // list masters merged across checked calendars
    private List<CalEntry>? occEntries;   // grid occurrences merged across checked calendars

    private View viewMode = View.List;
    private Grid gridMode = Grid.Month;
    private DateTime cursor = DateTime.Today;

    private string sortColumn = "start";
    private bool sortAscending = true;
    private string fCollection = string.Empty, fStart = string.Empty, fTitle = string.Empty, fLocation = string.Empty;
    private bool fRepeatsOnly;

    // Bulk move/delete (ADR 0055)
    private readonly HashSet<Guid> selectedIds = [];
    private string bulkTarget = string.Empty;
    private bool bulkBusy;
    private string? bulkMessage;

    private EventDto? selected;
    private Guid? selectedCalId;
    private string? selectedCalName;
    private string? selectedColor;
    private bool showEditor;
    private bool showImport;

    // --- Event editor (create + edit), including recurrence (ADR 0050) ---
    private Guid? editingId;                  // null = create
    private Guid? editorCalId;                // the calendar the editor writes to
    private string summary = string.Empty;
    private string attendees = string.Empty;
    private string location = string.Empty;
    private DateTime start = DateTime.Now;
    private DateTime? end;
    private bool isAllDay;
    private string? editorError;

    private string repeatFreq = string.Empty; // "" | DAILY | WEEKLY | MONTHLY | YEARLY
    private int repeatInterval = 1;
    private readonly HashSet<string> repeatDays = [];
    private string repeatEnd = "never";       // never | until | count
    private DateTime? repeatUntil;
    private int? repeatCount;
    private bool customRuleMode;              // an imported rule the editor can't model — preserved verbatim
    private string? customRule;

    // Monthly "Nth weekday" / "day N" (ADR 0051)
    private string monthlyMode = "day";       // day | weekday
    private int monthlyDay = 1;
    private int monthlyOrdinal = 1;           // 1..4, -1 = last
    private string monthlyWeekday = "MO";

    // Per-instance scope (ADR 0051)
    private string editScope = "series";      // series | this | following
    private DateTime? editRecurrenceId;       // the occurrence's RECURRENCE-ID, for this/following
    private string scopeAction = string.Empty; // "" | edit | delete
    private EventDto? scopeEvent;

    private static readonly (string Code, string Name)[] Weekdays =
        [("MO", "Mon"), ("TU", "Tue"), ("WE", "Wed"), ("TH", "Thu"), ("FR", "Fri"), ("SA", "Sat"), ("SU", "Sun")];

    private string FreqUnit => repeatFreq switch
    {
        "DAILY" => repeatInterval == 1 ? "day" : "days",
        "WEEKLY" => repeatInterval == 1 ? "week" : "weeks",
        "MONTHLY" => repeatInterval == 1 ? "month" : "months",
        "YEARLY" => repeatInterval == 1 ? "year" : "years",
        _ => "",
    };

    private Guid? splittingId;
    private DateTime splitAt;
    private IBrowserFile? pendingImport;
    private string conflict = "skip";
    private bool importSeparate = true; // default on: recreate the source calendars (Google export)
    private bool mergeByName = true;    // default on: merge files that share an X-WR-CALNAME
    private string? importMessage;
    private bool importing;   // an import is running — lock everything, including Close
    private bool importDone;  // an import finished — keep inputs locked; only Close stays active

    private bool showShare;
    private bool showRename;
    private string renameName = string.Empty;
    private string renameColor = "#3B82F6";
    private string? renameError;
    private bool showDelete;
    private string moveTarget = string.Empty;
    private string? moveError;

    private const string CheckedKey = "simplcal.calendar.checked";
    private const string ActiveKey = "simplcal.calendar.active";

    private bool IsZipSelected => pendingImport?.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) ?? false;
    private bool InputsLocked => importing || importDone;

    // The action target: the pane's active calendar, else the first accessible one.
    private Guid? EffectiveId => activeId ?? calendars?.FirstOrDefault()?.Id;
    private CalendarDto? ActiveCalendar => calendars?.FirstOrDefault(c => c.Id == EffectiveId);
    private string? ActiveCalendarName => ActiveCalendar?.Name;

    private List<CollectionsPane.Item> PaneItems() =>
        (calendars ?? []).Select(c => new CollectionsPane.Item(
            c.Id, c.Name, CollectionColors.Effective(c.Id, c.MyColor, c.Color), c.MyColor is not null, c.Shared)).ToList();

    private static readonly string[] WeekdayNames = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private readonly HashSet<Guid> subscribedIds = [];

    private void OpenImport()
    {
        pendingImport = null;
        importSeparate = true;
        mergeByName = true;
        importMessage = null;
        importing = false;
        importDone = false;
        showImport = true;
    }

    private ElementReference eventTable;
    private IJSObjectReference? columnModule;
    private IJSObjectReference? columnResizer;
    private bool resizerReady;

    protected override void OnInitialized() => Live.CollectionChanged += OnCollectionChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (calendars is null)
        {
            calendars = await Api.GetCalendarsAsync();
            await LoadStateAsync();
        }

        // Deep-link: /calendars/{id} activates (and shows) that calendar.
        if (CalendarId is { } cid && calendars.Any(c => c.Id == cid))
        {
            activeId = cid;
            checkedIds.Add(cid);
        }

        await ReloadAllAsync();
        await SubscribeCheckedAsync();
    }

    private async Task LoadStateAsync()
    {
        if (stateLoaded)
        {
            return;
        }

        stateLoaded = true;
        var ids = calendars!.Select(c => c.Id).ToHashSet();

        checkedIds.Clear();
        foreach (var g in await ReadGuidsAsync(CheckedKey))
        {
            if (ids.Contains(g))
            {
                checkedIds.Add(g);
            }
        }

        if (checkedIds.Count == 0)
        {
            foreach (var g in ids) // default: show all
            {
                checkedIds.Add(g);
            }
        }

        var active = await ReadGuidAsync(ActiveKey);
        activeId = active is { } a && ids.Contains(a) ? a : calendars!.FirstOrDefault()?.Id;
    }

    private async Task<IReadOnlyList<Guid>> ReadGuidsAsync(string key)
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", key);
            return raw is { Length: > 0 }
                ? raw.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(s => Guid.TryParse(s, out var g) ? g : (Guid?)null)
                    .Where(g => g is not null).Select(g => g!.Value).ToList()
                : [];
        }
        catch
        {
            return [];
        }
    }

    private async Task<Guid?> ReadGuidAsync(string key)
    {
        var list = await ReadGuidsAsync(key);
        return list.Count == 1 ? list[0] : null;
    }

    private async Task SaveStateAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", CheckedKey, string.Join(",", checkedIds));
            await JS.InvokeVoidAsync("localStorage.setItem", ActiveKey, activeId?.ToString() ?? "");
        }
        catch
        {
            // localStorage unavailable — filter simply won't persist.
        }
    }

