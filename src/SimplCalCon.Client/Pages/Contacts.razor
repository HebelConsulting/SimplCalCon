@page "/address-books/{AddressBookId:guid?}"
@attribute [Authorize]
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Contacts</PageTitle>

@if (books is not null)
{
    <SectionContent SectionName="RibbonSection">
        @if (books.Count > 0)
        {
            <select value="@EffectiveId" @onchange="OnSwitch">
                @foreach (var b in books)
                {
                    <option value="@b.Id">@b.Name@(b.Shared ? " (shared)" : "")</option>
                }
            </select>
            <button @onclick="ExportAsync">Export .vcf</button>
            @if (EffectiveId is { } id)
            {
                <a class="ribbon-btn" href="share/address-books/@id">Share</a>
                <a class="ribbon-btn" href="trash/address-books/@id">Trash</a>
            }
        }
    </SectionContent>
}

<h1>Contacts</h1>

@if (books is null)
{
    <p>Loading…</p>
}
else if (books.Count == 0)
{
    <p>No address books yet — create one on the <a href="">Overview</a> tab.</p>
}
else if (contacts is null)
{
    <p>Loading…</p>
}
else
{
    <ul>
        @foreach (var contact in contacts)
        {
            <li>
                @contact.FormattedName @(contact.Emails.Count > 0 ? "— " + string.Join(", ", contact.Emails) : "")
                <a href="history/address-books/@EffectiveId/@contact.Id">History</a>
            </li>
        }
    </ul>
    @if (contacts.Count == 0)
    {
        <p>No contacts.</p>
    }

    <h2>New contact</h2>
    <div>
        <input placeholder="Name" @bind="name" />
        <input placeholder="Email" @bind="email" />
        <button @onclick="AddAsync">Add</button>
    </div>

    <h2>Import</h2>
    <div>
        <InputFile OnChange="OnImportFile" accept=".vcf" />
        <select @bind="conflict">
            <option value="skip">Skip duplicates</option>
            <option value="replace">Replace duplicates</option>
        </select>
        <button @onclick="ImportAsync" disabled="@(pendingImport is null)">Import</button>
    </div>
    @if (importMessage is not null)
    {
        <p>@importMessage</p>
    }
}

@code {
    [Parameter]
    public Guid? AddressBookId { get; set; }

    private IReadOnlyList<AddressBookDto>? books;
    private IReadOnlyList<ContactDto>? contacts;
    private string name = string.Empty;
    private string email = string.Empty;
    private IBrowserFile? pendingImport;
    private string conflict = "skip";
    private string? importMessage;

    private Guid? EffectiveId => AddressBookId ?? books?.FirstOrDefault()?.Id;

    protected override async Task OnParametersSetAsync()
    {
        books ??= await Api.GetAddressBooksAsync();
        contacts = EffectiveId is { } id ? await Api.GetContactsAsync(id) : null;
    }

    private void OnSwitch(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            Navigation.NavigateTo($"address-books/{id}");
        }
    }

    private async Task AddAsync()
    {
        if (!string.IsNullOrWhiteSpace(name) && EffectiveId is { } id)
        {
            var emails = string.IsNullOrWhiteSpace(email) ? Array.Empty<string>() : [email];
            await Api.CreateContactAsync(id, name, emails);
            name = string.Empty;
            email = string.Empty;
            await ReloadContactsAsync();
        }
    }

    private void OnImportFile(InputFileChangeEventArgs e) => pendingImport = e.File;

    private async Task ImportAsync()
    {
        if (pendingImport is null || EffectiveId is not { } id)
        {
            return;
        }

        using var buffer = new MemoryStream();
        await pendingImport.OpenReadStream(32 * 1024 * 1024).CopyToAsync(buffer);
        var result = await Api.ImportCollectionAsync("address-books", id, buffer.ToArray(), pendingImport.Name, conflict);
        importMessage = $"Imported {result?.Imported}, skipped {result?.Skipped}, failed {result?.Failed}.";
        pendingImport = null;
        await ReloadContactsAsync();
    }

    private async Task ExportAsync()
    {
        if (EffectiveId is { } id)
        {
            var bytes = await Api.ExportCollectionAsync("address-books", id);
            await JS.InvokeVoidAsync("simplDownload", "contacts.vcf", "text/vcard", Convert.ToBase64String(bytes));
        }
    }

    private async Task ReloadContactsAsync()
    {
        if (EffectiveId is { } id)
        {
            contacts = await Api.GetContactsAsync(id);
        }
    }
}
