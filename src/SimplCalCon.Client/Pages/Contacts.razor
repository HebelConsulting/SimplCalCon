@page "/address-books/{AddressBookId:guid?}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject LiveUpdates Live

<PageTitle>Contacts</PageTitle>

@if (books is not null)
{
    <SectionContent SectionName="RibbonSection">
        <button @onclick="() => showNewBook = true">New address book</button>
        @if (EffectiveId is { } rid)
        {
            <button @onclick="NewContactAsync">New contact</button>
            <button @onclick="OpenImport">Import</button>
            <button @onclick="ExportAsync">Export .vcf</button>
            <button @onclick="OpenRename">Rename</button>
            <button @onclick="OpenDelete">Delete</button>
            <button @onclick="() => showShare = true">Share</button>
            <a class="ribbon-btn" href="trash/address-books/@rid">Trash</a>
        }
    </SectionContent>
}

@if (books is null)
{
    <p>Loading…</p>
}
else if (books.Count == 0)
{
    <p>No address books yet — use <strong>New address book</strong> in the ribbon above.</p>
}
else
{
    <div class="cal-layout">
        <CollectionsPane Heading="Address books"
                         EmptyText="No address books."
                         Collections="PaneItems()"
                         Checked="checkedIds"
                         ActiveId="activeId"
                         OnFilterChanged="OnFilterChangedAsync"
                         OnActiveChanged="OnActiveChangedAsync"
                         OnColorChanged="OnColorChangedAsync"
                         OnColorReset="OnColorResetAsync"
                         Deleted="DeletedPaneItems()"
                         OnRestore="OnRestoreAsync"
                         OnPurge="OnPurgeRequested" />

        <div class="cal-main">
            @if (entries is null)
            {
                <p>Loading…</p>
            }
            else
            {
                <div class="contacts-split">
                    <div class="contacts-list" @ref="listPane">
                        @if (selectedIds.Count > 0)
                        {
                            <div class="bulk-bar">
                                <span>@selectedIds.Count selected</span>
                                @if (books is { Count: > 1 })
                                {
                                    <select @bind="bulkTarget">
                                        <option value="">Move to…</option>
                                        @foreach (var b in books)
                                        {
                                            <option value="@b.Id">@b.Name</option>
                                        }
                                    </select>
                                    <button @onclick="BulkMoveAsync" disabled="@(string.IsNullOrEmpty(bulkTarget) || bulkBusy)">Move</button>
                                }
                                <button class="danger" @onclick="BulkDeleteAsync" disabled="@bulkBusy">Delete</button>
                                <button @onclick="ClearBulk">Clear</button>
                                @if (bulkMessage is not null)
                                {
                                    <span class="bulk-message">@bulkMessage</span>
                                }
                            </div>
                        }
                        <table @ref="contactTable" class="contact-table">
                            <thead>
                                <tr>
                                    <th class="sel-col"><input type="checkbox" checked="@AllSelected" @onchange="ToggleSelectAll" /></th>
                                    <th class="color-col">•</th>
                                    <th @onclick='() => Sort("book")'>Address book <span class="sort">@Indicator("book")</span></th>
                                    <th @onclick='() => Sort("name")'>Name <span class="sort">@Indicator("name")</span></th>
                                    <th @onclick='() => Sort("org")'>Organization <span class="sort">@Indicator("org")</span></th>
                                    <th @onclick='() => Sort("email")'>Email <span class="sort">@Indicator("email")</span></th>
                                    <th @onclick='() => Sort("phone")'>Phone <span class="sort">@Indicator("phone")</span></th>
                                    <th class="photo-col" @onclick='() => Sort("photo")'>Photo <span class="sort">@Indicator("photo")</span></th>
                                </tr>
                                <tr class="filter-row">
                                    <th class="sel-col"></th>
                                    <th class="color-col"></th>
                                    <th><FilterInput @bind-Value="filterBook" Placeholder="Filter…" /></th>
                                    <th><FilterInput @bind-Value="filterName" Placeholder="Filter…" /></th>
                                    <th><FilterInput @bind-Value="filterOrg" Placeholder="Filter…" /></th>
                                    <th><FilterInput @bind-Value="filterEmail" Placeholder="Filter…" /></th>
                                    <th><FilterInput @bind-Value="filterPhone" Placeholder="Filter…" /></th>
                                    <th class="photo-col">
                                        <label title="Show only contacts that have a photo">
                                            <input type="checkbox" @bind="filterPhotoOnly" /> only
                                        </label>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in View())
                                {
                                    <tr class="@(selected?.Id == c.Contact.Id ? "selected" : null)" @onclick="() => SelectAsync(c)">
                                        <td class="sel-col" @onclick:stopPropagation>
                                            <input type="checkbox" checked="@selectedIds.Contains(c.Contact.Id)" @onchange="() => ToggleSelected(c.Contact.Id)" />
                                        </td>
                                        <td class="color-col"><span class="swatch" style="background:@c.Color"></span></td>
                                        <td>@c.BookName</td>
                                        <td>@c.Contact.FormattedName</td>
                                        <td>@c.Contact.Organization</td>
                                        <td>@c.Contact.Emails.FirstOrDefault()</td>
                                        <td>@c.Contact.Phones.FirstOrDefault()</td>
                                        <td class="photo-col">@(c.Contact.HasPhoto ? "📷" : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (entries.Count == 0)
                        {
                            <p class="empty">No contacts in the shown address books.</p>
                        }
                        else if (!View().Any())
                        {
                            <p class="empty">No contacts match the filter.</p>
                        }
                    </div>

                    <div class="splitter" @ref="splitterHandle" title="Drag to resize"></div>

                    <div class="contacts-detail">
                        @if (selected is null)
                        {
                            <p class="detail-empty">Select a contact to view or edit it.</p>
                        }
                        else
                        {
                            <div class="detail-photo">
                                @if (selectedPhoto is not null)
                                {
                                    @* A server-served data URL (ADR 0037): no cross-origin fetch, so no referrer concerns. *@
                                    <img src="@selectedPhoto" alt="Contact photo" />
                                }
                                else
                                {
                                    <div class="detail-photo-none">No photo in this card</div>
                                }
                            </div>
                            <div class="detail-book">
                                <span class="swatch" style="background:@selectedColor"></span> @selectedBookName
                            </div>
                            <div class="detail-vcard">
                                <div class="detail-vcard-head">
                                    <span>vCard @(editing ? "(editing)" : "(read-only)")</span>
                                    <span class="detail-vcard-actions">
                                        @if (!editing)
                                        {
                                            <button @onclick="StartEdit">Edit</button>
                                        }
                                        else
                                        {
                                            <button @onclick="SaveAsync" disabled="@busy">Save</button>
                                            <button @onclick="CancelEdit" disabled="@busy">Cancel</button>
                                        }
                                    </span>
                                </div>
                                <textarea class="vcard-text" readonly="@(!editing)" @bind="editBuffer" @bind:event="oninput"></textarea>
                                @if (detailMessage is not null)
                                {
                                    <p class="detail-msg">@detailMessage</p>
                                }
                            </div>
                            @if (!editing && books is { Count: > 1 })
                            {
                                <div class="detail-move">
                                    <label>Move to</label>
                                    <select @bind="moveTarget">
                                        <option value="">— choose address book —</option>
                                        @foreach (var b in books.Where(b => b.Id != selectedBookId))
                                        {
                                            <option value="@b.Id">@b.Name</option>
                                        }
                                    </select>
                                    <button @onclick="MoveContactAsync" disabled="@(string.IsNullOrEmpty(moveTarget) || busy)">Move</button>
                                </div>
                                @if (moveError is not null)
                                {
                                    <p class="detail-msg">@moveError</p>
                                }
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

<Modal Visible="showNewBook" Title="New address book" OnClose="() => showNewBook = false">
    <input placeholder="Name" @bind="newBookName" />
    <div>
        <button @onclick="CreateBookAsync" disabled="@string.IsNullOrWhiteSpace(newBookName)">Create</button>
    </div>
</Modal>

<Modal Visible="showImport" Title="Import contacts (.vcf or .zip)" CloseDisabled="@busy" OnClose="CloseImport">
    <InputFile OnChange="OnImportFile" accept=".vcf,.zip" disabled="@InputsLocked" />
    @if (IsZipSelected)
    {
        <label class="form-check" title="Recreate the original address books from the archive (e.g. a Google export)">
            <input type="checkbox" @bind="importSeparate" disabled="@InputsLocked" />
            <span>Create a separate address book for each file in the archive</span>
        </label>
        @if (importSeparate)
        {
            <label class="form-check" title="Files that resolve to the same name are merged into one address book">
                <input type="checkbox" @bind="mergeByName" disabled="@InputsLocked" />
                <span>Assign entries by their name — don't create multiple address books with the same name</span>
            </label>
        }
    }
    <label>
        On duplicate:
        <select @bind="importConflict" disabled="@InputsLocked">
            <option value="skip">Skip</option>
            <option value="replace">Replace</option>
        </select>
    </label>
    <div>
        <button @onclick="ImportAsync" disabled="@(pendingImport is null || InputsLocked)">Import</button>
        <button @onclick="CloseImport" disabled="@busy">Close</button>
    </div>
    @if (busy)
    {
        <p>Importing…</p>
    }
    else if (importMessage is not null)
    {
        <p>@importMessage</p>
    }
</Modal>

<Modal Visible="showRename" Title="Edit address book" OnClose="() => showRename = false">
    <div class="form-row"><label>Name</label><input @bind="renameName" placeholder="Address book name" /></div>
    <div class="form-row">
        <label>Default colour</label>
        <input type="color" @bind="renameColor" />
        <span class="hint">Shared with everyone; each person can still pick their own.</span>
    </div>
    <div class="form-row">
        <label>Subscription</label>
        @if (ActiveBook?.FeedToken is { } token && EffectiveId is { } fid)
        {
            <div class="feed-box">
                <input class="feed-url" readonly value="@FeedUrl("address-books", fid, token, "vcf")" />
                <button type="button" @onclick='() => CopyAsync(FeedUrl("address-books", fid, token, "vcf"))'>Copy</button>
                <button type="button" @onclick="ResetFeedAsync">Reset</button>
                <button type="button" class="danger" @onclick="DisableFeedAsync">Disable</button>
                <span class="hint">Read-only .vcf feed. Support varies by client (mainstream apps subscribe to calendars, not contacts).</span>
            </div>
        }
        else
        {
            <button type="button" @onclick="EnableFeedAsync">Enable subscription link</button>
        }
    </div>
    <div class="form-actions">
        <button @onclick="RenameAsync" disabled="@string.IsNullOrWhiteSpace(renameName)">Save</button>
        <button @onclick="() => showRename = false">Cancel</button>
    </div>
    @if (renameError is not null)
    {
        <p class="detail-msg">@renameError</p>
    }
</Modal>

<Modal Visible="showDelete" Title="Delete address book" OnClose="() => showDelete = false">
    <p>Delete address book “<strong>@ActiveBookName</strong>”? Its contacts will no longer appear. This can be undone by an administrator.</p>
    <p class="confirm-hint">To confirm, type the address book's name — <strong>@ActiveBookName</strong> — below.</p>
    <input type="text" class="confirm-input" @bind="deleteConfirm" @bind:event="oninput"
           placeholder="@ActiveBookName" autocomplete="off" aria-label="Type the address book name to confirm deletion" />
    <div class="form-actions">
        <button class="danger" @onclick="DeleteAsync" disabled="@(!DeleteConfirmed)">Delete</button>
        <button @onclick="() => showDelete = false">Cancel</button>
    </div>
</Modal>

<Modal Visible="purgeId is not null" Title="Delete address book permanently" OnClose="() => purgeId = null">
    <p><strong>Permanently delete</strong> “<strong>@purgeName</strong>” and <strong>all its contacts and history</strong>? This <strong>cannot be undone</strong>.</p>
    <p class="confirm-hint">To confirm, type the address book's name — <strong>@purgeName</strong> — below.</p>
    <input type="text" class="confirm-input" @bind="purgeConfirm" @bind:event="oninput"
           placeholder="@purgeName" autocomplete="off" aria-label="Type the address book name to confirm permanent deletion" />
    <div class="form-actions">
        <button class="danger" @onclick="PurgeAsync" disabled="@(!PurgeConfirmed)">Delete permanently</button>
        <button @onclick="() => purgeId = null">Cancel</button>
    </div>
</Modal>

<Modal Visible="showShare" Title="Share address book" OnClose="() => showShare = false">
    @if (EffectiveId is { } sid)
    {
        <ShareEditor Kind="address-books" CollectionId="sid" />
    }
</Modal>

@code {
    [Parameter] public Guid? AddressBookId { get; set; }

    // One shown contact tagged with its owning address book (ADR 0062).
    private sealed record ContactEntry(ContactDto Contact, Guid BookId, string BookName, string Color);

    private IReadOnlyList<AddressBookDto>? books;
    private IReadOnlyList<AddressBookDto> deletedBooks = [];   // owner's soft-deleted address books (ADR 0075)
    private readonly HashSet<Guid> checkedIds = [];
    private Guid? activeId;
    private bool stateLoaded;

    private List<ContactEntry>? entries;

    private ContactDto? selected;
    private Guid? selectedBookId;
    private string? selectedBookName;
    private string? selectedColor;
    private string? selectedRaw;
    private string? selectedEtag;
    private string? selectedPhoto;
    private string editBuffer = string.Empty;
    private bool editing;
    private bool busy;
    private string? detailMessage;

    private string sortColumn = "name";
    private bool sortAscending = true;

    private string filterBook = string.Empty;
    private string filterName = string.Empty;
    private string filterOrg = string.Empty;
    private string filterEmail = string.Empty;
    private string filterPhone = string.Empty;
    private bool filterPhotoOnly;

    // Bulk move/delete (ADR 0055)
    private readonly HashSet<Guid> selectedIds = [];
    private string bulkTarget = string.Empty;
    private bool bulkBusy;
    private string? bulkMessage;

    private ElementReference listPane;
    private ElementReference splitterHandle;
    private ElementReference contactTable;
    private IJSObjectReference? splitterModule;
    private IJSObjectReference? splitter;
    private IJSObjectReference? columnModule;
    private IJSObjectReference? columnResizer;
    private bool splitterReady;

    private bool showNewBook;
    private string newBookName = string.Empty;
    private bool showImport;
    private IBrowserFile? pendingImport;
    private string importConflict = "skip";
    private bool importSeparate = true; // default on: recreate the source address books (Google export)
    private bool mergeByName = true;    // default on: merge files that share a name
    private string? importMessage;
    private bool importDone;  // an import finished — keep inputs locked; only Close stays active

    private bool showShare;
    private bool showRename;
    private string renameName = string.Empty;
    private string renameColor = "#3B82F6";
    private string? renameError;
    private bool showDelete;
    private string deleteConfirm = string.Empty;
    private string moveTarget = string.Empty;
    private string? moveError;

    private const string CheckedKey = "simplcal.contacts.checked";
    private const string ActiveKey = "simplcal.contacts.active";

    private bool IsZipSelected => pendingImport?.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) ?? false;
    private bool InputsLocked => busy || importDone;

    private Guid? EffectiveId => activeId ?? books?.FirstOrDefault()?.Id;
    private AddressBookDto? ActiveBook => books?.FirstOrDefault(b => b.Id == EffectiveId);
    private string? ActiveBookName => ActiveBook?.Name;

    // Type-to-confirm guard for the irreversible collection delete: exact (trimmed, case-sensitive) match.
    private bool DeleteConfirmed =>
        !string.IsNullOrWhiteSpace(ActiveBookName) &&
        string.Equals(deleteConfirm.Trim(), ActiveBookName!.Trim(), StringComparison.Ordinal);

    private List<CollectionsPane.Item> PaneItems() =>
        (books ?? []).Select(b => new CollectionsPane.Item(
            b.Id, b.Name, CollectionColors.Effective(b.Id, b.MyColor, b.Color), b.MyColor is not null, b.Shared)).ToList();

    private List<CollectionsPane.Item> DeletedPaneItems() =>
        deletedBooks.Select(b => new CollectionsPane.Item(
            b.Id, b.Name, CollectionColors.Effective(b.Id, b.MyColor, b.Color), false, b.Shared)).ToList();

    private async Task OnRestoreAsync(Guid id)
    {
        await Api.RestoreCollectionAsync("address-books", id);
        books = await Api.GetAddressBooksAsync();
        deletedBooks = await Api.GetDeletedAddressBooksAsync();
        checkedIds.Add(id);                 // show the restored address book straight away
        await OnFilterChangedAsync();       // persist, reload the merged view, re-subscribe
    }

    // Permanent purge of a deleted address book (ADR 0077): type-the-name confirm, then hard-delete.
    private Guid? purgeId;
    private string purgeName = string.Empty;
    private string purgeConfirm = string.Empty;

    private bool PurgeConfirmed =>
        !string.IsNullOrWhiteSpace(purgeName) &&
        string.Equals(purgeConfirm.Trim(), purgeName.Trim(), StringComparison.Ordinal);

    private void OnPurgeRequested(Guid id)
    {
        purgeName = deletedBooks.FirstOrDefault(b => b.Id == id)?.Name ?? string.Empty;
        purgeConfirm = string.Empty;
        purgeId = id;
    }

    private async Task PurgeAsync()
    {
        if (purgeId is not { } id || !PurgeConfirmed)
        {
            return;
        }

        await Api.PurgeCollectionAsync("address-books", id);
        purgeId = null;
        purgeConfirm = string.Empty;
        deletedBooks = await Api.GetDeletedAddressBooksAsync();
    }

    private readonly HashSet<Guid> subscribedIds = [];

    protected override void OnInitialized() => Live.CollectionChanged += OnCollectionChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (books is null)
        {
            books = await Api.GetAddressBooksAsync();
            deletedBooks = await Api.GetDeletedAddressBooksAsync();
            await LoadStateAsync();
        }

        // Deep-link: /address-books/{id} activates (and shows) that book.
        if (AddressBookId is { } bid && books.Any(b => b.Id == bid))
        {
            activeId = bid;
            checkedIds.Add(bid);
        }

        await ReloadAsync();
        await SubscribeCheckedAsync();
    }

    private async Task LoadStateAsync()
    {
        if (stateLoaded)
        {
            return;
        }

        stateLoaded = true;
        var ids = books!.Select(b => b.Id).ToHashSet();

        checkedIds.Clear();
        foreach (var g in await ReadGuidsAsync(CheckedKey))
        {
            if (ids.Contains(g))
            {
                checkedIds.Add(g);
            }
        }

        if (checkedIds.Count == 0)
        {
            foreach (var g in ids)
            {
                checkedIds.Add(g);
            }
        }

        var active = await ReadGuidAsync(ActiveKey);
        activeId = active is { } a && ids.Contains(a) ? a : books!.FirstOrDefault()?.Id;
    }

    private async Task<IReadOnlyList<Guid>> ReadGuidsAsync(string key)
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", key);
            return raw is { Length: > 0 }
                ? raw.Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(s => Guid.TryParse(s, out var g) ? g : (Guid?)null)
                    .Where(g => g is not null).Select(g => g!.Value).ToList()
                : [];
        }
        catch
        {
            return [];
        }
    }

    private async Task<Guid?> ReadGuidAsync(string key)
    {
        var list = await ReadGuidsAsync(key);
        return list.Count == 1 ? list[0] : null;
    }

    private async Task SaveStateAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", CheckedKey, string.Join(",", checkedIds));
            await JS.InvokeVoidAsync("localStorage.setItem", ActiveKey, activeId?.ToString() ?? "");
        }
        catch
        {
            // localStorage unavailable — filter simply won't persist.
        }
    }

    private async Task OnFilterChangedAsync()
    {
        await SaveStateAsync();
        await ReloadAsync();
        await SubscribeCheckedAsync();
    }

    private async Task OnActiveChangedAsync(Guid id)
    {
        activeId = id;
        await SaveStateAsync();
    }

    // The pane picker sets the caller's personal colour (ADR 0066) for everyone; reset clears it.
    private async Task OnColorChangedAsync((Guid Id, string Color) change)
    {
        await Api.SetMyColorAsync("address-books", change.Id, change.Color);
        await RefreshColorsAsync();
    }

    private async Task OnColorResetAsync(Guid id)
    {
        await Api.ClearMyColorAsync("address-books", id);
        await RefreshColorsAsync();
    }

    private async Task RefreshColorsAsync()
    {
        books = await Api.GetAddressBooksAsync();
        await ReloadAsync();
    }

    private IEnumerable<AddressBookDto> Visible() => (books ?? []).Where(b => checkedIds.Contains(b.Id));

    private async Task ReloadAsync()
    {
        if (books is null)
        {
            return;
        }

        var list = new List<ContactEntry>();
        foreach (var b in Visible())
        {
            var color = CollectionColors.Effective(b.Id, b.MyColor, b.Color);
            foreach (var c in await Api.GetContactsAsync(b.Id))
            {
                list.Add(new ContactEntry(c, b.Id, b.Name, color));
            }
        }

        entries = list;
        if (selected is not null && entries.All(e => e.Contact.Id != selected.Id))
        {
            ClearSelection();
        }
    }

    private async Task SubscribeCheckedAsync()
    {
        foreach (var id in checkedIds.Where(id => !subscribedIds.Contains(id)).ToList())
        {
            subscribedIds.Add(id);
            await Live.SubscribeAsync(id);
        }
    }

    // A live change to a shown address book → reload the merged view.
    private void OnCollectionChanged(Guid collectionId)
    {
        if (!checkedIds.Contains(collectionId))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await ReloadAsync();
            StateHasChanged();
        });
    }

    // Wire the draggable divider once the list/detail panes have rendered.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!splitterReady && entries is not null)
        {
            splitterReady = true;
            splitterModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/splitter.js");
            splitter = await splitterModule.InvokeAsync<IJSObjectReference>("init", splitterHandle, listPane);
            columnModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/columnResize.js");
            columnResizer = await columnModule.InvokeAsync<IJSObjectReference>("init", contactTable);
        }
    }

    // --- Sorting ---
    private void Sort(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string Indicator(string column) => sortColumn == column ? (sortAscending ? "▲" : "▼") : "";

    // Per-column filters + the photo checkbox, then the active sort.
    private IEnumerable<ContactEntry> View()
    {
        Func<ContactEntry, string> key = sortColumn switch
        {
            "book" => e => e.BookName,
            "org" => e => e.Contact.Organization ?? "",
            "email" => e => e.Contact.Emails.FirstOrDefault() ?? "",
            "phone" => e => e.Contact.Phones.FirstOrDefault() ?? "",
            "photo" => e => e.Contact.HasPhoto ? "1" : "0",
            _ => e => e.Contact.FormattedName ?? "",
        };
        var ordered = entries!.Where(Matches).OrderBy(key, StringComparer.OrdinalIgnoreCase);
        return sortAscending ? ordered : ordered.Reverse();
    }

    private bool Matches(ContactEntry e) =>
        Contains(e.BookName, filterBook)
        && Contains(e.Contact.FormattedName, filterName)
        && Contains(e.Contact.Organization, filterOrg)
        && Contains(string.Join(" ", e.Contact.Emails), filterEmail)
        && Contains(string.Join(" ", e.Contact.Phones), filterPhone)
        && (!filterPhotoOnly || e.Contact.HasPhoto);

    // --- Bulk selection (ADR 0055) ---
    private bool AllSelected => View().Any() && View().All(c => selectedIds.Contains(c.Contact.Id));

    private void ToggleSelected(Guid id)
    {
        if (!selectedIds.Remove(id))
        {
            selectedIds.Add(id);
        }

        bulkMessage = null;
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        var all = View().Select(c => c.Contact.Id).ToList();
        if (e.Value is true && !all.All(selectedIds.Contains))
        {
            foreach (var id in all)
            {
                selectedIds.Add(id);
            }
        }
        else
        {
            foreach (var id in all)
            {
                selectedIds.Remove(id);
            }
        }
    }

    private void ClearBulk()
    {
        selectedIds.Clear();
        bulkTarget = string.Empty;
        bulkMessage = null;
    }

    // Selected contacts may span address books; group by source for the per-collection bulk API.
    private Dictionary<Guid, List<Guid>> SelectedByBook() =>
        (entries ?? [])
            .Where(e => selectedIds.Contains(e.Contact.Id))
            .GroupBy(e => e.BookId)
            .ToDictionary(g => g.Key, g => g.Select(e => e.Contact.Id).ToList());

    private async Task BulkDeleteAsync()
    {
        if (selectedIds.Count == 0)
        {
            return;
        }

        bulkBusy = true;
        try
        {
            int ok = 0, failed = 0;
            foreach (var (bookId, ids) in SelectedByBook())
            {
                var result = await Api.BulkDeleteAsync("address-books", bookId, ids);
                ok += result?.Succeeded ?? 0;
                failed += result?.Failed ?? ids.Count;
            }

            await AfterBulkAsync($"Deleted {ok}{(failed > 0 ? $", {failed} failed" : "")}.");
        }
        finally
        {
            bulkBusy = false;
        }
    }

    private async Task BulkMoveAsync()
    {
        if (selectedIds.Count == 0 || !Guid.TryParse(bulkTarget, out var target))
        {
            return;
        }

        bulkBusy = true;
        try
        {
            int ok = 0, failed = 0;
            foreach (var (bookId, ids) in SelectedByBook())
            {
                if (bookId == target)
                {
                    continue;
                }

                var result = await Api.BulkMoveAsync("address-books", bookId, ids, target);
                ok += result?.Succeeded ?? 0;
                failed += result?.Failed ?? ids.Count;
            }

            await AfterBulkAsync($"Moved {ok}{(failed > 0 ? $", {failed} failed" : "")}.");
        }
        finally
        {
            bulkBusy = false;
        }
    }

    private async Task AfterBulkAsync(string message)
    {
        bulkMessage = message;
        if (selected is not null && selectedIds.Contains(selected.Id))
        {
            ClearSelection();
        }

        selectedIds.Clear();
        bulkTarget = string.Empty;
        await ReloadAsync();
    }

    private static bool Contains(string? value, string filter) =>
        string.IsNullOrWhiteSpace(filter) || (value ?? "").Contains(filter, StringComparison.OrdinalIgnoreCase);

    // --- Selection + raw view/edit ---
    private async Task SelectAsync(ContactEntry entry)
    {
        selected = entry.Contact;
        selectedBookId = entry.BookId;
        selectedBookName = entry.BookName;
        selectedColor = entry.Color;
        editing = false;
        detailMessage = null;
        moveTarget = string.Empty;
        moveError = null;
        var (vcard, etag) = await Api.GetContactRawAsync(entry.BookId, entry.Contact.Id);
        selectedRaw = vcard;
        selectedEtag = etag;
        editBuffer = vcard;
        // The server resolves + caches the photo (inline or external URL), so we just fetch bytes (ADR 0037).
        selectedPhoto = await Api.GetContactPhotoDataUrlAsync(entry.BookId, entry.Contact.Id);
    }

    private void StartEdit()
    {
        editing = true;
        detailMessage = null;
    }

    private void CancelEdit()
    {
        editing = false;
        editBuffer = selectedRaw ?? string.Empty;
    }

    private async Task SaveAsync()
    {
        if (selected is null || selectedBookId is not { } id)
        {
            return;
        }

        // Quick client-side sanity so obvious breakage doesn't need a round-trip; the server
        // is the authority (it parses and refuses to persist an invalid card).
        if (!editBuffer.Contains("BEGIN:VCARD", StringComparison.OrdinalIgnoreCase)
            || !editBuffer.Contains("END:VCARD", StringComparison.OrdinalIgnoreCase))
        {
            detailMessage = "This doesn't look like a vCard (missing BEGIN:VCARD / END:VCARD) — not saved.";
            return;
        }

        busy = true;
        detailMessage = null;

        var error = await Api.PutContactRawAsync(id, selected.Id, editBuffer, selectedEtag);
        if (error is not null)
        {
            // Invalid card / conflict: keep editing with the text intact, show why.
            detailMessage = error;
            busy = false;
            return;
        }

        editing = false;
        var contactId = selected.Id;
        await ReloadAsync();
        var again = entries!.FirstOrDefault(e => e.Contact.Id == contactId);
        if (again is not null)
        {
            await SelectAsync(again);
        }

        detailMessage = "Saved.";
        busy = false;
    }

    private void ClearSelection()
    {
        selected = null;
        selectedBookId = null;
        selectedRaw = selectedEtag = selectedPhoto = null;
        editBuffer = string.Empty;
        editing = false;
        detailMessage = null;
    }

    private async Task MoveContactAsync()
    {
        if (selectedBookId is not { } id || selected is null || !Guid.TryParse(moveTarget, out var targetId))
        {
            return;
        }

        moveError = await Api.MoveEntryAsync("address-books", id, selected.Id, targetId);
        if (moveError is null)
        {
            moveTarget = string.Empty;
            ClearSelection();
            await ReloadAsync();
        }
    }

    // --- Ribbon actions ---
    private async Task NewContactAsync()
    {
        if (EffectiveId is not { } id)
        {
            return;
        }

        var created = await Api.CreateContactAsync(id, "New Contact", []);
        await ReloadAsync();
        var fresh = entries!.FirstOrDefault(e => e.Contact.Id == created?.Id);
        if (fresh is not null)
        {
            await SelectAsync(fresh);
            StartEdit();
        }
    }

    private async Task CreateBookAsync()
    {
        if (string.IsNullOrWhiteSpace(newBookName))
        {
            return;
        }

        var created = await Api.CreateAddressBookAsync(newBookName);
        newBookName = string.Empty;
        showNewBook = false;
        books = await Api.GetAddressBooksAsync();
        if (created is not null)
        {
            checkedIds.Add(created.Id);
            activeId = created.Id;
            await SaveStateAsync();
            await ReloadAsync();
            await SubscribeCheckedAsync();
        }
    }

    private void OnImportFile(InputFileChangeEventArgs e) => pendingImport = e.File;

    private void CloseImport()
    {
        showImport = false;
        pendingImport = null;
        importSeparate = true;
        importMessage = null;
        importDone = false;
    }

    private void OpenImport()
    {
        pendingImport = null;
        importSeparate = true;
        mergeByName = true;
        importMessage = null;
        importDone = false;
        showImport = true;
    }

    private void OpenRename()
    {
        renameName = ActiveBookName ?? string.Empty;
        renameColor = ActiveBook is { } b ? CollectionColors.For(b.Id, b.Color) : "#3B82F6";
        renameError = null;
        showRename = true;
    }

    private async Task RenameAsync()
    {
        if (EffectiveId is not { } id || string.IsNullOrWhiteSpace(renameName))
        {
            return;
        }

        renameError = await Api.UpdateCollectionAsync("address-books", id, renameName.Trim(), renameColor);
        if (renameError is null)
        {
            books = await Api.GetAddressBooksAsync();
            await ReloadAsync();
            showRename = false;
        }
    }

    // --- Subscription feed (ADR 0069) ---
    private string FeedUrl(string kind, Guid id, string token, string ext) =>
        $"{Navigation.BaseUri}api/{kind}/{id}/feed/{token}.{ext}";

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch
        {
            // Clipboard blocked — the URL is still selectable in the field.
        }
    }

    private async Task EnableFeedAsync()
    {
        if (EffectiveId is { } id)
        {
            await Api.EnableFeedAsync("address-books", id);
            books = await Api.GetAddressBooksAsync();
        }
    }

    private Task ResetFeedAsync() => EnableFeedAsync();

    private async Task DisableFeedAsync()
    {
        if (EffectiveId is { } id)
        {
            await Api.DisableFeedAsync("address-books", id);
            books = await Api.GetAddressBooksAsync();
        }
    }

    private void OpenDelete()
    {
        deleteConfirm = string.Empty;
        showDelete = true;
    }

    private async Task DeleteAsync()
    {
        if (EffectiveId is not { } id || !DeleteConfirmed)
        {
            return;
        }

        await Api.DeleteCollectionAsync("address-books", id);
        showDelete = false;
        deleteConfirm = string.Empty;
        checkedIds.Remove(id);
        if (activeId == id)
        {
            activeId = null;
        }

        books = await Api.GetAddressBooksAsync();
        deletedBooks = await Api.GetDeletedAddressBooksAsync();   // the just-deleted book now shows under "Deleted"
        activeId ??= books.FirstOrDefault()?.Id;
        await SaveStateAsync();
        await ReloadAsync();
    }

    private async Task ImportAsync()
    {
        if (pendingImport is null || EffectiveId is not { } id)
        {
            return;
        }

        busy = true;
        try
        {
            using var buffer = new MemoryStream();
            await pendingImport.OpenReadStream(64 * 1024 * 1024).CopyToAsync(buffer);
            var result = await Api.ImportCollectionAsync("address-books", id, buffer.ToArray(), pendingImport.Name, importConflict, importSeparate, mergeByName);
            importMessage = result is { CreatedCollections: > 0 }
                ? $"Created {result.CreatedCollections} address book(s); imported {result.Imported}, skipped {result.Skipped}, failed {result.Failed}."
                : $"Imported {result?.Imported}, skipped {result?.Skipped}, failed {result?.Failed}.";
            importDone = true; // lock the inputs; the user can now only Close
            if (result is { CreatedCollections: > 0 })
            {
                books = await Api.GetAddressBooksAsync(); // new books appear in the pane
                foreach (var b in books)
                {
                    checkedIds.Add(b.Id);
                }

                await SaveStateAsync();
                await SubscribeCheckedAsync();
            }

            await ReloadAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ExportAsync()
    {
        if (EffectiveId is { } id)
        {
            var bytes = await Api.ExportCollectionAsync("address-books", id);
            await JS.InvokeVoidAsync("simplDownload", "contacts.vcf", "text/vcard", Convert.ToBase64String(bytes));
        }
    }

    public async ValueTask DisposeAsync()
    {
        Live.CollectionChanged -= OnCollectionChanged;
        try
        {
            if (splitter is not null)
            {
                await splitter.InvokeVoidAsync("dispose");
                await splitter.DisposeAsync();
            }

            if (columnResizer is not null)
            {
                await columnResizer.InvokeVoidAsync("dispose");
                await columnResizer.DisposeAsync();
            }

            if (splitterModule is not null)
            {
                await splitterModule.DisposeAsync();
            }

            if (columnModule is not null)
            {
                await columnModule.DisposeAsync();
            }
        }
        catch
        {
            // Best-effort teardown.
        }
    }
}
