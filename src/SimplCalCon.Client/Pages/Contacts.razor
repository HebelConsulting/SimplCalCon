@page "/address-books/{AddressBookId:guid}"
@attribute [Authorize]
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>Contacts</PageTitle>

<h1>Contacts</h1>
<p><a href="">← Collections</a> · <a href="share/address-books/@AddressBookId">Share</a> · <a href="trash/address-books/@AddressBookId">Trash</a></p>

@if (contacts is null)
{
    <p>Loading…</p>
}
else
{
    <ul>
        @foreach (var contact in contacts)
        {
            <li>
                @contact.FormattedName @(contact.Emails.Count > 0 ? "— " + string.Join(", ", contact.Emails) : "")
                <a href="history/address-books/@AddressBookId/@contact.Id">History</a>
            </li>
        }
    </ul>
    @if (contacts.Count == 0)
    {
        <p>No contacts.</p>
    }

    <h2>New contact</h2>
    <div>
        <input placeholder="Name" @bind="name" />
        <input placeholder="Email" @bind="email" />
        <button @onclick="AddAsync">Add</button>
    </div>

    <h2>Import / export</h2>
    <div>
        <InputFile OnChange="OnImportFile" accept=".vcf" />
        <select @bind="conflict">
            <option value="skip">Skip duplicates</option>
            <option value="replace">Replace duplicates</option>
        </select>
        <button @onclick="ImportAsync" disabled="@(pendingImport is null)">Import</button>
        <button @onclick="ExportAsync">Export .vcf</button>
    </div>
    @if (importMessage is not null)
    {
        <p>@importMessage</p>
    }
}

@code {
    [Parameter]
    public Guid AddressBookId { get; set; }

    private IReadOnlyList<ContactDto>? contacts;
    private string name = string.Empty;
    private string email = string.Empty;
    private IBrowserFile? pendingImport;
    private string conflict = "skip";
    private string? importMessage;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync() => contacts = await Api.GetContactsAsync(AddressBookId);

    private async Task AddAsync()
    {
        if (!string.IsNullOrWhiteSpace(name))
        {
            var emails = string.IsNullOrWhiteSpace(email) ? Array.Empty<string>() : [email];
            await Api.CreateContactAsync(AddressBookId, name, emails);
            name = string.Empty;
            email = string.Empty;
            await LoadAsync();
        }
    }

    private void OnImportFile(InputFileChangeEventArgs e) => pendingImport = e.File;

    private async Task ImportAsync()
    {
        if (pendingImport is null)
        {
            return;
        }

        using var buffer = new MemoryStream();
        await pendingImport.OpenReadStream(32 * 1024 * 1024).CopyToAsync(buffer);
        var result = await Api.ImportCollectionAsync("address-books", AddressBookId, buffer.ToArray(), pendingImport.Name, conflict);
        importMessage = $"Imported {result?.Imported}, skipped {result?.Skipped}, failed {result?.Failed}.";
        pendingImport = null;
        await LoadAsync();
    }

    private async Task ExportAsync()
    {
        var bytes = await Api.ExportCollectionAsync("address-books", AddressBookId);
        await JS.InvokeVoidAsync("simplDownload", "contacts.vcf", "text/vcard", Convert.ToBase64String(bytes));
    }
}
