@page "/admin"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Admin</PageTitle>

<h1>Administration</h1>

@if (me is null)
{
    <p>Loading…</p>
}
else if (!me.IsAdmin)
{
    <p>You do not have administrator access.</p>
}
else if (me.IsPlatformAdmin)
{
    <h2>Tenants</h2>
    @if (tenants is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <ul>
            @foreach (var t in tenants)
            {
                <li><strong>@t.Name</strong> — <code>@t.Slug</code> · @t.Status</li>
            }
        </ul>
        @if (tenants.Count == 0)
        {
            <p>No tenants.</p>
        }
    }
}
else
{
    <h2>Users in your tenant</h2>
    @if (users is null)
    {
        <p>Loading…</p>
    }
    else if (users.Count == 0)
    {
        <p>No users.</p>
    }
    else
    {
        <div class="admin-layout">
            <ul class="admin-user-list">
                @foreach (var u in users)
                {
                    <li class="@(selected?.Id == u.Id ? "selected" : null)" @onclick="() => selected = u">
                        <span class="admin-user-name">@u.DisplayName</span>
                        <span class="admin-user-meta">@u.Email · @u.Role · @u.Status</span>
                    </li>
                }
            </ul>

            @if (selected is not null)
            {
                <div class="admin-detail">
                    <h3>@selected.DisplayName</h3>
                    <p>@selected.Email · @selected.Role · @selected.Status</p>
                    <AvatarEditor Path="@($"api/users/{selected.Id}/photo")" Initials="@Initials(selected)" @key="selected.Id" />
                </div>
            }
        </div>
    }
}

@code {
    private MeDto? me;
    private IReadOnlyList<TenantDto>? tenants;
    private IReadOnlyList<AdminUserDto>? users;
    private AdminUserDto? selected;

    protected override async Task OnInitializedAsync()
    {
        me = await Api.GetMeAsync();
        if (me is null || !me.IsAdmin)
        {
            return;
        }

        if (me.IsPlatformAdmin)
        {
            tenants = await Api.GetTenantsAsync();
        }
        else
        {
            users = await Api.GetTenantUsersAsync();
        }
    }

    private static string Initials(AdminUserDto user)
    {
        var parts = (user.DisplayName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant(),
        };
    }
}
