@page "/admin"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Admin</PageTitle>

<h1>Administration</h1>

@if (me is null)
{
    <p>Loading…</p>
}
else if (!me.IsAdmin)
{
    <p>You do not have administrator access.</p>
}
else if (me.IsPlatformAdmin)
{
    <h2>Tenants</h2>
    @if (tenants is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <ul>
            @foreach (var t in tenants)
            {
                <li><strong>@t.Name</strong> — <code>@t.Slug</code> · @t.Status</li>
            }
        </ul>
        @if (tenants.Count == 0)
        {
            <p>No tenants.</p>
        }
    }
}
else
{
    <h2>Users in your tenant</h2>
    @if (users is null)
    {
        <p>Loading…</p>
    }
    else if (users.Count == 0)
    {
        <p>No users.</p>
    }
    else
    {
        <div class="admin-layout">
            <ul class="admin-user-list">
                @foreach (var u in users)
                {
                    <li class="@(selected?.Id == u.Id ? "selected" : null)" @onclick="() => selected = u">
                        <span class="admin-user-name">@u.DisplayName</span>
                        <span class="admin-user-meta">@u.Email · @u.Role · @u.Status</span>
                    </li>
                }
            </ul>

            @if (selected is not null)
            {
                <div class="admin-detail">
                    <h3>@selected.DisplayName</h3>
                    <p>@selected.Email · @selected.Role · @selected.Status</p>
                    <AvatarEditor Path="@($"api/users/{selected.Id}/photo")" Initials="@Initials(selected)" @key="selected.Id" />
                </div>
            }
        </div>
    }

    <h2>Email (SMTP) — invitations to external attendees</h2>
    @if (email is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="smtp-form">
            <label class="form-check"><input type="checkbox" @bind="email.Enabled" /> <span>Send invitation emails to attendees outside this tenant</span></label>
            <div class="form-row"><label>Host</label><input @bind="email.Host" placeholder="smtp.example.com" /></div>
            <div class="form-row"><label>Port</label><input type="number" @bind="email.Port" /></div>
            <label class="form-check"><input type="checkbox" @bind="email.UseStartTls" /> <span>Use STARTTLS</span></label>
            <div class="form-row"><label>Username</label><input @bind="email.Username" placeholder="(optional)" /></div>
            <div class="form-row"><label>Password</label><input type="password" @bind="newPassword" placeholder="@(email.HasPassword ? "•••••• — leave blank to keep" : "(optional)")" /></div>
            <div class="form-row"><label>From address</label><input @bind="email.FromAddress" placeholder="calendar@example.com" /></div>
            <div class="form-row"><label>From name</label><input @bind="email.FromName" placeholder="(optional)" /></div>

            <h3>Inbound (IMAP) — receive replies/invitations from external senders</h3>
            <label class="form-check"><input type="checkbox" @bind="email.InboundEnabled" /> <span>Poll a mailbox for incoming iMIP mail</span></label>
            <div class="form-row"><label>IMAP host</label><input @bind="email.ImapHost" placeholder="imap.example.com" /></div>
            <div class="form-row"><label>Port</label><input type="number" @bind="email.ImapPort" /></div>
            <label class="form-check"><input type="checkbox" @bind="email.ImapUseSsl" /> <span>Use SSL/TLS (implicit)</span></label>
            <div class="form-row"><label>Username</label><input @bind="email.ImapUsername" placeholder="(optional)" /></div>
            <div class="form-row"><label>Password</label><input type="password" @bind="newImapPassword" placeholder="@(email.HasImapPassword ? "•••••• — leave blank to keep" : "(optional)")" /></div>
            <div class="form-row"><label>Folder</label><input @bind="email.ImapFolder" placeholder="INBOX" /></div>
            <div class="form-row"><label>Test to</label><input @bind="testTo" placeholder="you@example.com" /></div>
            <div class="form-actions">
                <button @onclick="SaveEmailAsync" disabled="@savingEmail">Save</button>
                <button @onclick="SendTestAsync" disabled="@(savingEmail || string.IsNullOrWhiteSpace(testTo))">Send test email</button>
                @if (emailMessage is not null)
                {
                    <span class="smtp-message">@emailMessage</span>
                }
            </div>
        </div>
    }

    <h2>Groups — share with a set of people</h2>
    @if (groups is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="form-row">
            <input @bind="newGroupName" placeholder="New group name" />
            <button @onclick="CreateGroupAsync" disabled="@string.IsNullOrWhiteSpace(newGroupName)">Add group</button>
            @if (groupMessage is not null)
            {
                <span class="smtp-message">@groupMessage</span>
            }
        </div>
        <ul class="admin-user-list">
            @foreach (var g in groups)
            {
                <li>
                    <span class="admin-user-name">@g.Name</span>
                    <span class="admin-user-meta">@g.MemberCount member(s)</span>
                    <button @onclick="() => ManageGroupAsync(g)">@(managedGroupId == g.Id ? "Close" : "Manage")</button>
                    <button class="danger" @onclick="() => DeleteGroupAsync(g)">Delete</button>
                    @if (managedGroupId == g.Id)
                    {
                        <div class="group-members">
                            <ul>
                                @foreach (var m in members)
                                {
                                    <li>
                                        @m.DisplayName@(m.Kind == "group" ? " (group)" : "")
                                        <button @onclick="() => RemoveMemberAsync(g.Id, m.Id)">Remove</button>
                                    </li>
                                }
                            </ul>
                            <div class="form-row">
                                <input @bind="memberQuery" @bind:event="oninput" @bind:after="SearchMembersAsync" placeholder="Add member — search…" />
                            </div>
                            @if (searchResults.Count > 0)
                            {
                                <ul class="search-results">
                                    @foreach (var p in searchResults)
                                    {
                                        <li>
                                            <button @onclick="() => AddMemberAsync(g.Id, p)">
                                                @p.DisplayName@(p.Kind == "group" ? " (group)" : "") @p.Email
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </li>
            }
        </ul>
    }
}

@code {
    private MeDto? me;
    private IReadOnlyList<TenantDto>? tenants;
    private IReadOnlyList<AdminUserDto>? users;
    private AdminUserDto? selected;

    private EmailForm? email;
    private string newPassword = string.Empty;
    private string newImapPassword = string.Empty;
    private string testTo = string.Empty;
    private bool savingEmail;
    private string? emailMessage;

    // Groups (ADR 0059)
    private IReadOnlyList<GroupDto>? groups;
    private string newGroupName = string.Empty;
    private string? groupMessage;
    private Guid? managedGroupId;
    private IReadOnlyList<GroupMemberDto> members = [];
    private string memberQuery = string.Empty;
    private IReadOnlyList<PrincipalDto> searchResults = [];

    protected override async Task OnInitializedAsync()
    {
        me = await Api.GetMeAsync();
        if (me is null || !me.IsAdmin)
        {
            return;
        }

        if (me.IsPlatformAdmin)
        {
            tenants = await Api.GetTenantsAsync();
        }
        else
        {
            users = await Api.GetTenantUsersAsync();
            groups = await Api.GetGroupsAsync();
            var settings = await Api.GetTenantEmailSettingsAsync();
            email = new EmailForm
            {
                Enabled = settings?.Enabled ?? false,
                Host = settings?.Host ?? string.Empty,
                Port = settings?.Port ?? 587,
                UseStartTls = settings?.UseStartTls ?? true,
                Username = settings?.Username,
                HasPassword = settings?.HasPassword ?? false,
                FromAddress = settings?.FromAddress ?? string.Empty,
                FromName = settings?.FromName,
                InboundEnabled = settings?.InboundEnabled ?? false,
                ImapHost = settings?.ImapHost,
                ImapPort = settings?.ImapPort ?? 993,
                ImapUseSsl = settings?.ImapUseSsl ?? true,
                ImapUsername = settings?.ImapUsername,
                HasImapPassword = settings?.HasImapPassword ?? false,
                ImapFolder = settings?.ImapFolder ?? "INBOX",
            };
        }
    }

    private async Task SaveEmailAsync()
    {
        if (email is null)
        {
            return;
        }

        savingEmail = true;
        emailMessage = null;
        try
        {
            await Api.SaveTenantEmailSettingsAsync(new
            {
                enabled = email.Enabled,
                host = email.Host,
                port = email.Port,
                useStartTls = email.UseStartTls,
                username = email.Username,
                newPassword = string.IsNullOrEmpty(newPassword) ? null : newPassword,
                fromAddress = email.FromAddress,
                fromName = email.FromName,
                inboundEnabled = email.InboundEnabled,
                imapHost = email.ImapHost,
                imapPort = email.ImapPort,
                imapUseSsl = email.ImapUseSsl,
                imapUsername = email.ImapUsername,
                newImapPassword = string.IsNullOrEmpty(newImapPassword) ? null : newImapPassword,
                imapFolder = string.IsNullOrWhiteSpace(email.ImapFolder) ? "INBOX" : email.ImapFolder,
            });
            if (!string.IsNullOrEmpty(newPassword))
            {
                email.HasPassword = true;
                newPassword = string.Empty;
            }

            if (!string.IsNullOrEmpty(newImapPassword))
            {
                email.HasImapPassword = true;
                newImapPassword = string.Empty;
            }

            emailMessage = "Saved.";
        }
        catch
        {
            emailMessage = "Save failed — check the host and From address.";
        }
        finally
        {
            savingEmail = false;
        }
    }

    private async Task SendTestAsync()
    {
        savingEmail = true;
        emailMessage = null;
        try
        {
            var error = await Api.SendTestEmailAsync(testTo.Trim());
            emailMessage = error ?? $"Test email sent to {testTo.Trim()}.";
        }
        finally
        {
            savingEmail = false;
        }
    }

    // --- Groups (ADR 0059) ---
    private async Task CreateGroupAsync()
    {
        var response = await Api.CreateGroupAsync(newGroupName.Trim());
        groupMessage = response.IsSuccessStatusCode
            ? null
            : response.StatusCode == System.Net.HttpStatusCode.Conflict ? "A group with that name already exists." : "Couldn't create the group.";
        if (response.IsSuccessStatusCode)
        {
            newGroupName = string.Empty;
            groups = await Api.GetGroupsAsync();
        }
    }

    private async Task DeleteGroupAsync(GroupDto group)
    {
        await Api.DeleteGroupAsync(group.Id);
        if (managedGroupId == group.Id)
        {
            managedGroupId = null;
        }

        groups = await Api.GetGroupsAsync();
    }

    private async Task ManageGroupAsync(GroupDto group)
    {
        groupMessage = null;
        if (managedGroupId == group.Id)
        {
            managedGroupId = null;
            return;
        }

        managedGroupId = group.Id;
        memberQuery = string.Empty;
        searchResults = [];
        members = await Api.GetGroupMembersAsync(group.Id);
    }

    private async Task SearchMembersAsync() =>
        searchResults = memberQuery.Trim().Length == 0 ? [] : await Api.SearchPrincipalsAsync(memberQuery.Trim());

    private async Task AddMemberAsync(Guid groupId, PrincipalDto principal)
    {
        var response = await Api.AddGroupMemberAsync(groupId, principal.Id);
        groupMessage = response.IsSuccessStatusCode ? null : "Couldn't add that member (would it create a cycle?).";
        memberQuery = string.Empty;
        searchResults = [];
        members = await Api.GetGroupMembersAsync(groupId);
        groups = await Api.GetGroupsAsync();
    }

    private async Task RemoveMemberAsync(Guid groupId, Guid principalId)
    {
        await Api.RemoveGroupMemberAsync(groupId, principalId);
        members = await Api.GetGroupMembersAsync(groupId);
        groups = await Api.GetGroupsAsync();
    }

    private sealed class EmailForm
    {
        public bool Enabled { get; set; }
        public string Host { get; set; } = string.Empty;
        public int Port { get; set; } = 587;
        public bool UseStartTls { get; set; } = true;
        public string? Username { get; set; }
        public bool HasPassword { get; set; }
        public string FromAddress { get; set; } = string.Empty;
        public string? FromName { get; set; }

        // Inbound IMAP (ADR 0056)
        public bool InboundEnabled { get; set; }
        public string? ImapHost { get; set; }
        public int ImapPort { get; set; } = 993;
        public bool ImapUseSsl { get; set; } = true;
        public string? ImapUsername { get; set; }
        public bool HasImapPassword { get; set; }
        public string ImapFolder { get; set; } = "INBOX";
    }

    private static string Initials(AdminUserDto user)
    {
        var parts = (user.DisplayName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant(),
        };
    }
}
