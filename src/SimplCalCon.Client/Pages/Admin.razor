@page "/admin"
@attribute [Authorize]
@inject ApiClient Api

<PageTitle>Admin</PageTitle>

<h1>Administration</h1>

@if (me is null)
{
    <p>Loading…</p>
}
else if (!me.IsAdmin)
{
    <p>You do not have administrator access.</p>
}
else if (me.IsPlatformAdmin)
{
    <h2>Tenants</h2>
    @if (tenants is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <ul>
            @foreach (var t in tenants)
            {
                <li><strong>@t.Name</strong> — <code>@t.Slug</code> · @t.Status</li>
            }
        </ul>
        @if (tenants.Count == 0)
        {
            <p>No tenants.</p>
        }
    }
}
else
{
    <h2>Users in your tenant</h2>
    @if (users is null)
    {
        <p>Loading…</p>
    }
    else if (users.Count == 0)
    {
        <p>No users.</p>
    }
    else
    {
        <div class="admin-layout">
            <ul class="admin-user-list">
                @foreach (var u in users)
                {
                    <li class="@(selected?.Id == u.Id ? "selected" : null)" @onclick="() => selected = u">
                        <span class="admin-user-name">@u.DisplayName</span>
                        <span class="admin-user-meta">@u.Email · @u.Role · @u.Status</span>
                    </li>
                }
            </ul>

            @if (selected is not null)
            {
                <div class="admin-detail">
                    <h3>@selected.DisplayName</h3>
                    <p>@selected.Email · @selected.Role · @selected.Status</p>
                    <AvatarEditor Path="@($"api/users/{selected.Id}/photo")" Initials="@Initials(selected)" @key="selected.Id" />
                </div>
            }
        </div>
    }

    <h2>Email (SMTP) — invitations to external attendees</h2>
    @if (email is null)
    {
        <p>Loading…</p>
    }
    else
    {
        <div class="smtp-form">
            <label class="form-check"><input type="checkbox" @bind="email.Enabled" /> <span>Send invitation emails to attendees outside this tenant</span></label>
            <div class="form-row"><label>Host</label><input @bind="email.Host" placeholder="smtp.example.com" /></div>
            <div class="form-row"><label>Port</label><input type="number" @bind="email.Port" /></div>
            <label class="form-check"><input type="checkbox" @bind="email.UseStartTls" /> <span>Use STARTTLS</span></label>
            <div class="form-row"><label>Username</label><input @bind="email.Username" placeholder="(optional)" /></div>
            <div class="form-row"><label>Password</label><input type="password" @bind="newPassword" placeholder="@(email.HasPassword ? "•••••• — leave blank to keep" : "(optional)")" /></div>
            <div class="form-row"><label>From address</label><input @bind="email.FromAddress" placeholder="calendar@example.com" /></div>
            <div class="form-row"><label>From name</label><input @bind="email.FromName" placeholder="(optional)" /></div>
            <div class="form-actions">
                <button @onclick="SaveEmailAsync" disabled="@savingEmail">Save</button>
                @if (emailMessage is not null)
                {
                    <span class="smtp-message">@emailMessage</span>
                }
            </div>
        </div>
    }
}

@code {
    private MeDto? me;
    private IReadOnlyList<TenantDto>? tenants;
    private IReadOnlyList<AdminUserDto>? users;
    private AdminUserDto? selected;

    private EmailForm? email;
    private string newPassword = string.Empty;
    private bool savingEmail;
    private string? emailMessage;

    protected override async Task OnInitializedAsync()
    {
        me = await Api.GetMeAsync();
        if (me is null || !me.IsAdmin)
        {
            return;
        }

        if (me.IsPlatformAdmin)
        {
            tenants = await Api.GetTenantsAsync();
        }
        else
        {
            users = await Api.GetTenantUsersAsync();
            var settings = await Api.GetTenantEmailSettingsAsync();
            email = new EmailForm
            {
                Enabled = settings?.Enabled ?? false,
                Host = settings?.Host ?? string.Empty,
                Port = settings?.Port ?? 587,
                UseStartTls = settings?.UseStartTls ?? true,
                Username = settings?.Username,
                HasPassword = settings?.HasPassword ?? false,
                FromAddress = settings?.FromAddress ?? string.Empty,
                FromName = settings?.FromName,
            };
        }
    }

    private async Task SaveEmailAsync()
    {
        if (email is null)
        {
            return;
        }

        savingEmail = true;
        emailMessage = null;
        try
        {
            await Api.SaveTenantEmailSettingsAsync(new
            {
                enabled = email.Enabled,
                host = email.Host,
                port = email.Port,
                useStartTls = email.UseStartTls,
                username = email.Username,
                newPassword = string.IsNullOrEmpty(newPassword) ? null : newPassword,
                fromAddress = email.FromAddress,
                fromName = email.FromName,
            });
            if (!string.IsNullOrEmpty(newPassword))
            {
                email.HasPassword = true;
                newPassword = string.Empty;
            }

            emailMessage = "Saved.";
        }
        catch
        {
            emailMessage = "Save failed — check the host and From address.";
        }
        finally
        {
            savingEmail = false;
        }
    }

    private sealed class EmailForm
    {
        public bool Enabled { get; set; }
        public string Host { get; set; } = string.Empty;
        public int Port { get; set; } = 587;
        public bool UseStartTls { get; set; } = true;
        public string? Username { get; set; }
        public bool HasPassword { get; set; }
        public string FromAddress { get; set; } = string.Empty;
        public string? FromName { get; set; }
    }

    private static string Initials(AdminUserDto user)
    {
        var parts = (user.DisplayName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant(),
        };
    }
}
