<Project>
  <!--
    Central Package Management: every NuGet version is declared here once,
    and each project references packages without a Version attribute. This is
    the single source of truth the CI license gate and the version-pinned
    security overrides key off (docs/adr/0009, 0015).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core API -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Scalar (MIT): browsable OpenAPI UI at /scalar in Development (ADR 0009) -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.16" />
    <!--
      Security pin: Microsoft.AspNetCore.OpenApi floors Microsoft.OpenApi at the
      vulnerable 2.0.0 (GHSA-v5pm-xwqc-g5wc / NU1903, vulnerable <= 2.7.4). With
      transitive pinning enabled, declaring the fixed version here bumps it
      without needing an explicit PackageReference. See docs/adr/0009.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Structured logging (ADR 0033): Serilog (Apache-2.0) bundles the console sink,
         compact-JSON formatter, and appsettings binding used by the Api host. -->
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Auth: OpenIddict (Apache-2.0) OIDC server + EF stores; Identity password hasher primitive -->
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.6.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <!-- Calendar/contact format parsers (both MIT) for blob <-> indexed-field extraction (ADR 0003, 0004) -->
    <PackageVersion Include="Ical.Net" Version="5.2.3" />
    <PackageVersion Include="FolkerKinzel.VCards" Version="8.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Persistence (EF Core, dual provider: PostgreSQL + SQLite per ADR 0001) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Blazor WebAssembly client -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
    <PackageVersion Include="WebPush" Version="1.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <!-- Test stack -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>